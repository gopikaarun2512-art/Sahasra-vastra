{%- comment -%}
  Shop by category — the lemoon/lunabee grid of garment icons.

  Used twice: on the homepage under Shop by age, and as the whole of the
  Products page (templates/page.products.json). A tile does not jump to
  the category's full shelf: it opens the Products popup with that
  category chosen, which asks only the child's age (offering only the
  ages the category is made in) and lands on the category filtered to
  that age. With script off the tile is a plain link to the category.

  ── Where tiles come from ─────────────────────────────────────────────
  Categories with no products yet are left out (setting), so adding a
  new type to the menu ahead of stock never shows an empty tile.

  By default, the store's categories (snippets/sv-cat-list: the
  sv-categories menu, else the main menu's Products / Shop by Type item),
  in menu order, with each category's icon from snippets/sv-cat-icon.
  Add "Category" blocks only to override that — pick the collections and,
  if wanted, a different icon for this section alone.
{%- endcomment -%}

{%- liquid
  assign tiles = section.blocks | where: 'type', 'category'
  assign use_blocks = false
  for b in tiles
    if b.settings.collection != blank
      assign use_blocks = true
      break
    endif
  endfor
  unless use_blocks
    capture cats_raw
      render 'sv-cat-list'
    endcapture
    assign cats = cats_raw | strip | split: '||'
  endunless
  assign shape = section.settings.shape | default: 'square'
-%}

<section
  class="sv-cats sv-cats--{{ shape }}"
  data-sv
  {% if section.settings.auto_open %}data-sv-finder-autoopen{% endif %}
  style="--sv-cats-cols: {{ section.settings.columns | default: 6 }}; --sv-cats-cols-m: {{ section.settings.columns_mobile | default: 2 }}; --sv-cats-max: {{ section.settings.tile_size | default: 300 }}px;"
>
  <div class="w w--wide">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <header class="sv-cats__head">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow sv-cats__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="sv-cats__h">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.sub != blank -%}
          <p class="sv-cats__sub">{{ section.settings.sub }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- capture tiles_html -%}
      {%- if use_blocks -%}
        {%- for block in tiles -%}
          {%- assign col = block.settings.collection -%}
          {%- if col == blank -%}{%- continue -%}{%- endif -%}
          {%- assign label = block.settings.label | default: col.title -%}
          <li class="sv-cats__cell" {{ block.shopify_attributes }}>
            <a class="sv-cats__tile" href="{{ col.url }}" data-sv-finder data-sv-finder-cat="{{ col.handle }}">
              <span class="sv-cats__icon">
                {%- if block.settings.icon != blank -%}
                  {{ block.settings.icon | image_url: width: 480 | image_tag: widths: '160, 240, 320, 480', sizes: '(max-width: 749px) 30vw, 180px', loading: 'lazy', alt: '', class: 'sv-cats__img' }}
                {%- else -%}
                  {%- render 'sv-cat-icon', collection: col, sizes: '(max-width: 749px) 30vw, 180px', class: 'sv-cats__img' -%}
                {%- endif -%}
              </span>
              <span class="sv-cats__name">{{ label }}</span>
            </a>
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for c in cats -%}
          {%- assign cp = c | split: '::' -%}
          {%- assign cp_h = cp[0] -%}{%- assign col = collections[cp_h] -%}
          {%- if col == blank or col.id == blank -%}{%- continue -%}{%- endif -%}
          {%- if col.products_count == 0 and section.settings.show_empty == false -%}{%- continue -%}{%- endif -%}
          <li class="sv-cats__cell">
            <a class="sv-cats__tile" href="{{ col.url }}" data-sv-finder data-sv-finder-cat="{{ col.handle }}">
              <span class="sv-cats__icon">
                {%- render 'sv-cat-icon', collection: col, sizes: '(max-width: 749px) 30vw, 180px', class: 'sv-cats__img' -%}
              </span>
              <span class="sv-cats__name">{{ cp[1] }}</span>
            </a>
          </li>
        {%- endfor -%}
      {%- endif -%}
    {%- endcapture -%}
    {%- assign tile_count = tiles_html | split: 'class="sv-cats__cell"' | size | minus: 1 -%}
    <ul class="sv-cats__grid" role="list" style="--sv-cats-n: {{ tile_count | at_least: 1 }};">{{ tiles_html }}</ul>

    {%- if section.settings.cta_label != blank -%}
      <p class="sv-cats__cta">
        <a class="btn btn--ghost" href="{{ routes.root_url | append: 'pages/products' | replace: '//', '/' }}" data-sv-finder>{{ section.settings.cta_label }}</a>
      </p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  /* Tight under Shop by age: that band already ends on its own padding,
     so this one adds none above. */
  section[data-sv].sv-cats {
    padding: 0 0 var(--c);
  }

  .sv-cats__head {
    margin-bottom: var(--b);
    text-align: center;
  }

  /* Same centred label as Shop by age's "Start with the age": emerald,
     stepped up from the corner-label size, with a gold dash either side. */
  [data-sv] .sv-cats__head .sv-cats__eyebrow {
    justify-content: center;
    max-width: none;
    margin: 0;
    font-size: 0.92rem;
    font-weight: 500;
    letter-spacing: 0.26em;
    color: var(--emerald);
  }

  .sv-cats__head .sv-cats__eyebrow::after {
    content: "";
    width: 44px;
    height: 1px;
    background: var(--tan);
  }

  [data-sv] .sv-cats__h {
    margin: 10px 0 0;
    font-family: var(--serif);
    font-size: clamp(1.8rem, 3.4vw, 2.6rem);
    font-weight: 500;
    color: var(--emerald);
  }

  [data-sv] .sv-cats__sub {
    max-width: 56ch;
    margin: 10px auto 0;
    color: var(--grey);
  }

  /* As many columns as there are tiles (up to the setting), each column
     an equal share of the row, and every tile centred in its share — so
     two categories sit at a quarter and three quarters, six fill the row
     edge to edge, and no row ever ends in a run of empty space. */
  [data-sv] .sv-cats__grid {
    display: grid;
    grid-template-columns: repeat(min(var(--sv-cats-n), var(--sv-cats-cols)), minmax(0, 1fr));
    justify-items: center;
    gap: var(--b) var(--a);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sv-cats__cell {
    width: min(100%, var(--sv-cats-max));
  }

  .sv-cats__tile {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 14px;
    color: var(--ink);
    text-decoration: none;
  }

  /* Rounded frame with the name as an emerald pill over its corner —
     the same card as the New-in "first drop" frame. */
  .sv-cats__icon {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    border-radius: 20px;
    background: color-mix(in srgb, var(--emerald) 6%, transparent);
    overflow: hidden;
    transition: transform var(--std) var(--e), box-shadow var(--std) var(--e);
  }

  .sv-cats--circle .sv-cats__icon {
    border-radius: 999px;
  }

  .sv-cats__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sv-cats__tile:hover .sv-cats__icon,
  .sv-cats__tile:focus-visible .sv-cats__icon {
    box-shadow: var(--sh-s);
    transform: translateY(-3px);
  }

  .sv-cats__name {
    position: absolute;
    left: 16px;
    bottom: 16px;
    max-width: calc(100% - 32px);
    padding: 10px 18px;
    border-radius: 999px;
    background: var(--emerald);
    color: var(--cream);
    font-family: var(--sans);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: transform var(--std) var(--e);
  }

  .sv-cats__tile:hover .sv-cats__name,
  .sv-cats__tile:focus-visible .sv-cats__name {
    transform: translateY(-3px);
  }

  /* A pill cannot sit on a circle's corner; there the name stays below. */
  .sv-cats--circle .sv-cats__name {
    position: static;
    max-width: none;
    padding: 0;
    background: none;
    color: var(--emerald);
    font-size: 1.1rem;
    font-weight: 500;
    letter-spacing: normal;
    text-transform: none;
    text-align: center;
    transform: none;
  }

  [data-sv] .sv-cats__cta {
    max-width: none;
    margin: var(--b) 0 0;
    text-align: center;
  }

  @media (max-width: 1100px) {
    [data-sv] .sv-cats__grid {
      grid-template-columns: repeat(min(var(--sv-cats-n), var(--sv-cats-cols), 4), minmax(0, 1fr));
    }
  }

  @media (max-width: 749px) {
    /* Short dashes and a tighter step so the label stays on one line. */
    [data-sv] .sv-cats__head .sv-cats__eyebrow {
      gap: 12px;
      font-size: 0.8rem;
      letter-spacing: 0.2em;
    }

    .sv-cats__head .sv-cats__eyebrow::before,
    .sv-cats__head .sv-cats__eyebrow::after {
      width: 24px;
    }

    [data-sv] .sv-cats__grid {
      grid-template-columns: repeat(min(var(--sv-cats-n), var(--sv-cats-cols-m)), minmax(0, 1fr));
      gap: var(--a) 12px;
    }

    .sv-cats__name {
      left: 10px;
      bottom: 10px;
      max-width: calc(100% - 20px);
      padding: 7px 12px;
      font-size: 0.6rem;
      letter-spacing: 0.1em;
    }

    .sv-cats--circle .sv-cats__name {
      font-size: 0.95rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sv-cats__tile:hover .sv-cats__icon,
    .sv-cats__tile:hover .sv-cats__name {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "SV Shop by category",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Shop by category" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "sub", "label": "Line under the heading" },
    {
      "type": "select",
      "id": "shape",
      "label": "Icon shape",
      "options": [
        { "value": "square", "label": "Square" },
        { "value": "circle", "label": "Circle" }
      ],
      "default": "square"
    },
    { "type": "range", "id": "columns", "label": "Most icons per row (desktop)", "min": 3, "max": 10, "step": 1, "default": 6 },
    { "type": "range", "id": "tile_size", "label": "Largest icon size", "min": 160, "max": 420, "step": 20, "unit": "px", "default": 300 },
    { "type": "range", "id": "columns_mobile", "label": "Icons per row (phone)", "min": 2, "max": 4, "step": 1, "default": 2 },
    { "type": "text", "id": "cta_label", "label": "Button under the grid", "info": "Opens the Products popup. Leave empty for no button." },
    { "type": "checkbox", "id": "show_empty", "label": "Show categories that have no products yet", "default": false },
    { "type": "checkbox", "id": "auto_open", "label": "Open the age question as soon as the page loads", "info": "Turn on for the Products page only.", "default": false },
    { "type": "paragraph", "content": "Tiles come from your categories menu automatically (the 'sv-categories' menu, or the main menu's Products / Shop by Type item). Icons come from each collection's image. Add Category blocks only to pick different collections or icons here." }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Label", "info": "Defaults to the collection title." },
        { "type": "image_picker", "id": "icon", "label": "Icon", "info": "Square, e.g. a flat garment on a plain ground. Defaults to the collection image." }
      ]
    }
  ],
  "presets": [{ "name": "SV Shop by category" }]
}
{% endschema %}

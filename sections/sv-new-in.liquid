      "info": "Leads the shelf as a launch card in the first cell; one fewer product shows beside it. Blank drops it."
    },
    { "type": "text", "id": "campaign_label", "label": "Campaign label (fallback)", "default": "The first drop" },
    {
      "type": "collection",
      "id": "collection",

      "info": "While this collection is empty the band shows All products instead of an empty frame."
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products shown",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "auto_scroll",
      "label": "Glide the shelf",
      "info": "With more cards than fit one row, the shelf steps sideways on its own — pausable, still under hover or focus, off with reduced motion; phones always scroll it by thumb. Raise \"Products shown\" above 4 to give it something to glide for.",
      "default": true
    },
    { "type": "text", "id": "cta_label", "label": "View-all label", "default": "View everything new" }

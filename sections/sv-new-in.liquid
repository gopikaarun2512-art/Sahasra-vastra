    {
      "type": "text",
      "id": "line",
      "label": "Line under the eyebrow",
      "default": "What's just arrived, in real garment photography."
    },
    { "type": "header", "content": "Launch imagery" },
    {
      "type": "image_picker",
      "id": "banner",

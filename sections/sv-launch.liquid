<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" defer></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" defer></script>
<script>
(function(){
  'use strict';

  function boot(){

  'use strict';

  /* ---------- setup ---------- */
  document.documentElement.classList.add('sv-js');
  try{ history.scrollRestoration = 'manual'; }catch(e){}

  var TARGET = Date.parse({{ section.settings.launch_iso | default: '2026-09-27T15:00:00+05:30' | json }});
  if(isNaN(TARGET)) TARGET = Date.parse('2026-09-27T15:00:00+05:30');
  var LAUNCH = Date.parse('2026-09-10T00:00:00+05:30'); /* campaign start, for the progress bar */

  /* preview-only demo hooks: ?sv_demo=open | ?sv_demo=final */
  var demoActive = false;
  try{
    var demo = new URLSearchParams(location.search).get('sv_demo');
    if(demo === 'open'){ TARGET = Date.now() - 1000; demoActive = true; }
    if(demo === 'final'){ TARGET = Date.now() + 14000; demoActive = true; }
  }catch(e){}

  var reduced = false;
  try{ reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches; }catch(e){}
  if(reduced) document.documentElement.classList.add('sv-reduced');

  function lsSet(k,v){ try{ window.localStorage.setItem(k,v); }catch(e){} }

  var $ = function(id){ return document.getElementById(id); };
  var scene = $('sv-scene'), hero = $('sv-hero'), opening = $('sv-opening'),
      hint = $('sv-hint'), glow = $('sv-glow'), rays = $('sv-rays'),
      seam = $('sv-seam'), vignette = $('sv-vignette'),
      emblem = $('sv-emblem'), brandwrap = $('sv-brandwrap'),
      brand = $('sv-brand'), dev = $('sv-dev'), tagline = $('sv-tagline'),
      countdown = $('sv-countdown'), reveal = $('sv-reveal'),
      sticky = $('sv-sticky'), stickyCount = $('sv-sticky-count'),
      formWrap = $('sv-form-wrap'), form = $('sv-waitlist'), formStatus = $('sv-form-status');

  var isOpen = false;
  var storyActive = false, storyTrigger = null, storyTl = null, storyBrandW = 0;

  /* ---------- countdown ---------- */
  function pad2(n){ return (n < 10 ? '0' : '') + n; }

  function setDigits(unit, str){
    var box = countdown.querySelector('[data-unit="' + unit + '"]');
    if(!box) return;
    while(box.children.length > str.length) box.removeChild(box.firstChild);
    while(box.children.length < str.length){
      var d = document.createElement('span');
      d.className = 'sv-digit';
      var v = document.createElement('span');
      v.textContent = '';
      d.appendChild(v);
      box.insertBefore(d, box.firstChild);
    }
    for(var i = 0; i < str.length; i++){
      var cell = box.children[i], ch = str.charAt(i);
      while(cell.children.length > 1) cell.removeChild(cell.firstChild);
      var cur = cell.firstChild;
      cur.classList.remove('sv-in', 'sv-out');
      if(cur.textContent === ch) continue;
      if(reduced || cur.textContent === ''){
        cur.textContent = ch;
        continue;
      }
      /* roll: old slides up out, new slides up in (~250ms) */
      cur.classList.add('sv-out');
      (function(old){ setTimeout(function(){ if(old.parentNode) old.parentNode.removeChild(old); }, 320); })(cur);
      var inc = document.createElement('span');
      inc.className = 'sv-in';
      inc.textContent = ch;
      cell.appendChild(inc);
      void inc.offsetWidth; /* force reflow so the transition always runs */
      inc.classList.remove('sv-in');
    }
  }

  var clockTimer = null, lastDays = null, finalBurstDone = false;
  function tick(){
    var now = Date.now(), diff = TARGET - now;
    if(diff <= 0){ enterOpen(); return; }
    var total = Math.floor(diff / 1000);
    var days = Math.floor(total / 86400),
        hrs  = Math.floor((total % 86400) / 3600),
        mins = Math.floor((total % 3600) / 60),
        secs = total % 60;

    var pf = $('sv-progress-fill');
    if(pf){
      var p = Math.min(1, Math.max(0, (now - LAUNCH) / (TARGET - LAUNCH)));
      pf.style.width = (p * 100).toFixed(2) + '%';
    }
    /* a day rolls over, or the last ten seconds begin: small celebration from the plaque */
    if(!reduced){
      if(lastDays !== null && days < lastDays) plaqueBurst();
      if(total <= 10 && !finalBurstDone){ finalBurstDone = true; plaqueBurst(); }
    }
    lastDays = days;

    var daysUnit = $('sv-unit-days'), daysColon = $('sv-colon-days');
    var hideDays = (diff < 86400000) ? 'none' : '';
    if(daysUnit) daysUnit.style.display = hideDays;
    if(daysColon) daysColon.style.display = hideDays;

    setDigits('days', pad2(days));
    setDigits('hours', pad2(hrs));
    setDigits('minutes', pad2(mins));
    setDigits('seconds', pad2(secs));

    countdown.classList.toggle('is-final', total <= 10);

    if(stickyCount){
      stickyCount.textContent = (days > 0)
        ? days + 'd ' + pad2(hrs) + 'h'
        : pad2(hrs) + 'h ' + pad2(mins) + 'm';
    }
    var sr = $('sv-count-sr');
    if(sr && (secs === 0 || !sr.textContent)){ /* immediately on load, then once a minute */
      sr.textContent = days + ' days, ' + hrs + ' hours and ' + mins + ' minutes until opening';
    }
    clockTimer = setTimeout(tick, 1000 - (Date.now() % 1000) + 20);
  }

  /* ---------- open state ---------- */
  function enterOpen(){
    if(isOpen) return;
    isOpen = true;
    if(clockTimer) clearTimeout(clockTimer);
    if(storyActive && storyTrigger){
      storyTrigger.kill(true);
      storyTrigger = null;
      teardownStoryStyles();
    }
    if(!demoActive) lsSet('sv_reveal_seen', '1');
    document.documentElement.classList.add('is-open');
    document.documentElement.classList.remove('sv-ambient-on');
    if(!reduced) burstPetals();
  }

  function petalBurst(host, n, baseDist, spread){
    if(!host || !host.animate) return;
    var petal = '<svg viewBox="-10 -82 20 84" xmlns="http://www.w3.org/2000/svg"><path d="M0 0 C -9 -30 -6 -62 0 -80 C 6 -62 9 -30 0 0 Z" fill="#C6A15B"/></svg>';
    for(var i = 0; i < n; i++){
      var el = document.createElement('i');
      el.innerHTML = petal;
      host.appendChild(el);
      var ang = (i / n) * Math.PI * 2 + (i % 3) * 0.12,
          dist = baseDist + ((i * 53) % spread),
          x = Math.cos(ang) * dist, y = Math.sin(ang) * dist,
          rot = ((i * 137) % 360) - 180,
          dur = 1400 + ((i * 97) % 900);
      el.animate([
        { transform: 'translate(0,0) rotate(0deg) scale(.4)', opacity: 0.9 },
        { transform: 'translate(' + x + 'px,' + y + 'px) rotate(' + rot + 'deg) scale(1)', opacity: 0 }
      ], { duration: dur, easing: 'cubic-bezier(.2,.7,.3,1)', fill: 'forwards' });
      (function(node, t){ setTimeout(function(){ if(node.parentNode) node.parentNode.removeChild(node); }, t + 100); })(el, dur);
    }
  }
  function burstPetals(){ petalBurst($('sv-burst'), 26, 120, 190); }
  function plaqueBurst(){
    var plaque = $('sv-plaque');
    if(!plaque) return;
    var host = document.createElement('span');
    host.style.cssText = 'position:absolute;left:50%;top:50%;width:0;height:0;pointer-events:none;z-index:2';
    host.className = 'sv-burst';
    plaque.appendChild(host);
    petalBurst(host, 10, 50, 90);
    setTimeout(function(){ if(host.parentNode) host.parentNode.removeChild(host); }, 2600);
  }

  /* ---------- ambient loops ---------- */
  var ambientBuilt = false;
  function buildDust(){
    var dust = $('sv-dust');
    if(!dust || dust.children.length) return;
    var lefts = [6, 14, 24, 33, 41, 50, 58, 66, 74, 83, 90, 96];
    for(var i = 0; i < lefts.length; i++){
      var el = document.createElement('i');
      el.style.left = lefts[i] + 'vw';
      el.style.animationDuration = (11 + (i % 5) * 3.5) + 's';
      el.style.animationDelay = (-i * 2.7) + 's';
      var sc = 0.6 + ((i * 37) % 10) / 14;
      el.style.width = el.style.height = (4 * sc).toFixed(1) + 'px';
      dust.appendChild(el);
    }
  }
  /* sparkle glints timed to the 4.5s shine sweep across the brand */
  var sparklesArmed = false;
  function armSparkles(){
    if(sparklesArmed || reduced) return;
    sparklesArmed = true;
    var box = $('sv-sparkles');
    if(!box || !box.animate) return;
    var star = '<svg viewBox="0 0 24 24"><path d="M12 0 L14.3 9.7 L24 12 L14.3 14.3 L12 24 L9.7 14.3 L0 12 L9.7 9.7 Z" fill="#FFF6D9"/></svg>';
    function spawn(){
      if(document.hidden || isOpen) return;
      if(!document.documentElement.classList.contains('sv-ambient-on')) return;
      var r = box.getBoundingClientRect();
      if(r.bottom < 0 || r.top > window.innerHeight) return; /* off-screen */
      for(var i = 0; i < 3; i++){
        (function(i){
          setTimeout(function(){
            var el = document.createElement('i');
            el.innerHTML = star;
            el.style.left = (6 + Math.random() * 86) + '%';
            el.style.top = (Math.random() * 70) + '%';
            box.appendChild(el);
            el.animate([
              { transform: 'scale(0) rotate(0deg)',    opacity: 0 },
              { transform: 'scale(1) rotate(45deg)',   opacity: 1, offset: .4 },
              { transform: 'scale(0) rotate(90deg)',   opacity: 0 }
            ], { duration: 650, easing: 'ease-in-out' });
            setTimeout(function(){ if(el.parentNode) el.parentNode.removeChild(el); }, 700);
          }, i * 160);
        })(i);
      }
    }
    /* the shine band crosses the letters in the later part of each 4.5s cycle */
    setTimeout(function(){ spawn(); setInterval(spawn, 4500); }, 2600);
  }

  function startAmbient(){
    if(reduced || isOpen) return;
    document.documentElement.classList.add('sv-ambient-on');
    buildDust();
    armSparkles();
    if(ambientBuilt) return;
    ambientBuilt = true;
    var fall = $('sv-fall');
    if(!fall) return;
    var petal = '<svg viewBox="-10 -82 20 84" xmlns="http://www.w3.org/2000/svg"><path d="M0 0 C -9 -30 -6 -62 0 -80 C 6 -62 9 -30 0 0 Z" fill="#C6A15B"/></svg>';
    var lefts = [8, 22, 37, 55, 68, 81, 92];
    for(var i = 0; i < 7; i++){
      var el = document.createElement('i');
      el.innerHTML = petal;
      el.style.left = lefts[i] + 'vw';
      el.style.animationDuration = (26 + i * 5) + 's';
      el.style.animationDelay = (-i * 7) + 's';
      fall.appendChild(el);
    }
  }

  /* ---------- sticky bar ---------- */
  if('IntersectionObserver' in window && formWrap){
    new IntersectionObserver(function(entries){
      var inView = entries[0].isIntersecting && entries[0].intersectionRatio > 0.15;
      /* during the story the form overlays the viewport while still invisible —
         only count it as "in view" once it has actually faded in */
      if(inView && storyTrigger && storyTrigger.isActive){
        inView = parseFloat(window.getComputedStyle(formWrap).opacity || '1') > 0.4;
      }
      sticky.classList.toggle('is-hidden', inView);
    }, { threshold: [0, 0.15, 0.5] }).observe(formWrap);
    /* while pinned it's opacity (not geometry) that changes, so poll gently */
    setInterval(function(){
      if(!storyTrigger || !storyTrigger.isActive) return;
      var r = formWrap.getBoundingClientRect();
      var inView = r.top < window.innerHeight && r.bottom > 0 &&
        parseFloat(window.getComputedStyle(formWrap).opacity || '1') > 0.4;
      sticky.classList.toggle('is-hidden', inView);
    }, 600);
  }
  $('sv-notify-btn').addEventListener('click', function(ev){
    ev.preventDefault();
    formWrap.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'center' });
    var em = $('sv-email');
    if(em) setTimeout(function(){ try{ em.focus({ preventScroll: true }); }catch(e){} }, reduced ? 0 : 700);
  });

  /* ---------- email form: client check, then the real Shopify POST ---------- */
  if(form) form.addEventListener('submit', function(ev){
    var input = $('sv-email'), err = $('sv-form-error');
    if(!input) return;
    var val = (input.value || '').trim();
    var ok = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(val);
    if(!ok){
      ev.preventDefault();
      if(err){ err.textContent = 'Please enter a valid email address.'; err.hidden = false; }
      input.setAttribute('aria-invalid', 'true');
      input.setAttribute('aria-describedby', 'sv-form-error');
      input.focus();
      return;
    }
    if(err) err.hidden = true;
    input.removeAttribute('aria-invalid');
  });

  /* ---------- store owner: open Horizon's password dialog ---------- */
  var ownerLink = $('sv-owner-link');
  if(ownerLink) ownerLink.addEventListener('click', function(ev){
    ev.preventDefault();
    var dlg = document.querySelector('#password-form dialog');
    if(dlg){ try{ dlg.showModal(); }catch(e){ dlg.setAttribute('open', ''); } }
  });

  /* ---------- scroll story ---------- */
  function splitLetters(){
    if(brand.querySelector('.sv-ltr')) return;
    var text = brand.textContent;
    brand.textContent = '';
    for(var i = 0; i < text.length; i++){
      var ch = text.charAt(i);
      if(ch === ' '){
        brand.appendChild(document.createTextNode(' '));
      }else{
        var s = document.createElement('span');
        s.className = 'sv-ltr';
        s.setAttribute('aria-hidden', 'true');
        s.textContent = ch;
        brand.appendChild(s);
      }
    }
  }
  function splitWords(){
    if(tagline.querySelector('.sv-word')) return;
    var full = tagline.textContent;
    var words = full.split(' ');
    tagline.textContent = '';
    tagline.setAttribute('aria-label', full);
    for(var i = 0; i < words.length; i++){
      var s = document.createElement('span');
      s.className = 'sv-word';
      s.setAttribute('aria-hidden', 'true');
      s.textContent = words[i];
      tagline.appendChild(s);
      if(i < words.length - 1) tagline.appendChild(document.createTextNode(' '));
    }
  }
  function rnd(i, spread){ /* deterministic scatter */
    var x = Math.sin(i * 127.1 + 311.7) * 43758.5453;
    return ((x - Math.floor(x)) * 2 - 1) * spread;
  }

  function teardownStoryStyles(){
    storyActive = false;
    scene.classList.remove('is-story');
    document.documentElement.classList.remove('sv-stage-open');
    if(window.gsap){
      gsap.set([hero, reveal, opening, hint, glow, rays, seam, vignette, emblem, brandwrap, dev,
                '#sv-shade-l', '#sv-shade-r',
                '#sv-backdrop', '#sv-divider',
                '.sv-ltr', '.sv-word', '.sv-reveal-item'], { clearProps: 'all' });
      scene.querySelectorAll('.sv-po, .sv-pi, #sv-hub-a, #sv-hub-b').forEach(function(el){
        el.removeAttribute('transform');
      });
    }
  }

  function flattenBrand(){
    /* letter spans + shimmer's background-clip don't mix (painted boxes),
       so once the story is done the brand goes back to plain text */
    if(brand.querySelector('.sv-ltr')){
      brand.textContent = brand.getAttribute('aria-label') || 'SAHASRA VASTRA';
    }
  }

  function storyDone(){
    flattenBrand();
    pauseShadeVideos(); /* the shades are offscreen now — stop compositing video */
    startAmbient();
  }
  var rebuildQueued = false;
  function storyResume(){
    /* the visitor scrolled back into the story from the resting page */
    document.documentElement.classList.remove('sv-ambient-on');
    loadShadeVideos();
    if(!brand.querySelector('.sv-ltr') && !rebuildQueued){
      /* the flatten removed the letter spans the timeline animates — rebuild in place */
      rebuildQueued = true;
      setTimeout(function(){ rebuildQueued = false; rebuildStory(); }, 0);
    }
  }
  function rebuildStory(){
    if(!storyActive || !storyTrigger || isOpen) return;
    var p = storyTrigger.progress;
    storyTrigger.kill(true); storyTrigger = null;
    if(storyTl){ storyTl.kill(); storyTl = null; }
    teardownStoryStyles();
    if(Date.now() >= TARGET) return;
    initStory(true);
    if(storyTrigger){
      window.scrollTo(0, storyTrigger.start + (storyTrigger.end - storyTrigger.start) * p);
      ScrollTrigger.update();
      /* snap the scrub to the restored position — otherwise it REPLAYS the whole
         story to catch up (Act I's headline streaks across the settled page) */
      if(storyTrigger && storyTrigger.getTween){
        var tw = storyTrigger.getTween();
        if(tw) tw.progress(1);
      }
    }
  }

  function loadShadeVideos(){
    scene.querySelectorAll('.sv-shadevid').forEach(function(v){
      if(!v.src){
        v.src = v.getAttribute('data-src');
        v.addEventListener('error', function(){ v.remove(); }); /* gradient shade remains */
      }
      var p = v.play();
      if(p && p.catch) p.catch(function(){});
    });
  }
  function pauseShadeVideos(){
    scene.querySelectorAll('.sv-shadevid').forEach(function(v){
      try{ v.pause(); }catch(e){}
    });
  }

  var videosOn = false;
  function requestShadeVideos(){
    if(videosOn) return;
    videosOn = true;
    loadShadeVideos(); /* lazy: 2×4MB only starts downloading once the visitor scrolls */
  }

  function initStory(keepScroll){
    storyActive = true;
    try{ history.scrollRestoration = 'manual'; }catch(e){}
    if(!keepScroll) window.scrollTo(0, 0);
    document.documentElement.classList.remove('sv-ambient-on'); /* no shimmer mid-story */
    scene.classList.add('is-story');
    scene.classList.toggle('sv-fresh', !keepScroll);
    requestShadeVideos(); /* the silk motion IS the opening frame — load it right away */
    splitLetters();
    splitWords();
    buildDust();
    gsap.registerPlugin(ScrollTrigger);

    var letters = brand.querySelectorAll('.sv-ltr');
    var words = tagline.querySelectorAll('.sv-word');
    var outer = scene.querySelectorAll('.sv-po');
    var inner = scene.querySelectorAll('.sv-pi');

    /* measure so the final frame always fits the viewport */
    var vh = window.innerHeight, vw = window.innerWidth;
    var heroH = 0;
    (function(){
      var a = emblem.getBoundingClientRect(),
          t = tagline.getBoundingClientRect();
      heroH = Math.max(360, t.bottom - a.top);
    })();
    var rvKids = reveal.querySelectorAll('.sv-reveal-item');
    var rvH = 0;
    rvKids.forEach(function(k){
      if(k.offsetParent !== null || k.getBoundingClientRect().height){
        rvH += k.getBoundingClientRect().height + 14;
      }
    });
    storyBrandW = brand.offsetWidth; /* fingerprint for the late-font rebuild check */
    var s0 = Math.min(1, Math.max(0.92, (vh * 0.7) / heroH)); /* >1 would clip the full-width name */
    var sEnd = Math.min(s0 * 0.85, Math.max(0.55, (vh - rvH - 44) / heroH));
    /* centre the final frame as ONE stack (hero + reveal), not hero-at-top / reveal-at-bottom */
    var GAP = 24;
    var totalH = heroH * sEnd + GAP + rvH;
    var heroTop = Math.max(12, (vh - totalH) / 2);
    var yEnd = heroTop - (vh - heroH * sEnd) / 2;
    /* the reveal naturally stacks at the viewport bottom; lift it up under the hero */
    var revealY = Math.min(0, (heroTop + heroH * sEnd + GAP) - (vh - 32 - rvH));

    /* before states (finished state is the CSS default) */
    gsap.set(hero, { scale: s0, y: 0, transformOrigin: '50% 50%' });

    /* the brand starts as a screen-filling overlay, then settles into its slot */
    var bRect = brand.getBoundingClientRect();
    var bFill = Math.min((vw * 0.96) / bRect.width, 5);
    var yFill = (vh / 2) - (bRect.top + bRect.height / 2);
    /* the translation happens INSIDE the s0-scaled hero, so divide it back out */
    gsap.set(brandwrap, { y: yFill / s0, scale: bFill, transformOrigin: '50% 50%' });

    /* the stage set assembles as the darkness parts */
    gsap.set('#sv-backdrop', { opacity: 0 });

    gsap.set('#sv-shade-l', { opacity: 1, xPercent: 0, skewX: 0 });
    gsap.set('#sv-shade-r', { opacity: 1, xPercent: 0, skewX: 0 });
    gsap.set(seam, { opacity: 0.55, scaleX: 1 });
    gsap.set(vignette, { opacity: 0.9 });
    gsap.set(glow, { scale: 0.25, opacity: 0, transformOrigin: '50% 50%' });
    gsap.set(rays, { opacity: 0 });
    gsap.set(emblem, { opacity: 1, scale: 1 });
    gsap.set(outer, { attr: { transform: 'scale(0)' } });
    gsap.set(inner, { attr: { transform: 'scale(0)' } });
    gsap.set(['#sv-hub-a', '#sv-hub-b'], { attr: { transform: 'scale(0)' } });
    letters.forEach(function(l, i){
      gsap.set(l, { x: rnd(i, 60), y: rnd(i + 40, 44), rotation: rnd(i + 80, 30), scale: 1.5, opacity: 0 });
    });
    gsap.set(dev, { opacity: 0, y: 12 });
    gsap.set('#sv-divider', { opacity: 0, scaleX: 0.4 });
    gsap.set(words, { opacity: 0, y: 14 });
    gsap.set(['#sv-plaque', '#sv-date'], { autoAlpha: 0, y: 60 }); /* autoAlpha: invisible AND unfocusable */
    gsap.set(formWrap, { autoAlpha: 0 }); /* fade only — a y-shift would poke out of the footer box */
    gsap.set(hint, { opacity: 1 });

    /* intro: the seam fades in via CSS (sv-seamin); the opening line greets fresh loads only */
    if(!keepScroll){
      gsap.fromTo(opening, { opacity: 0, y: 16 },
        { opacity: 1, y: 0, duration: 1.5, ease: 'power2.out', delay: 0.3 });
    }

    var tl = gsap.timeline({
      scrollTrigger: {
        trigger: scene,
        start: 'top top',
        end: '+=350%',
        pin: true,
        scrub: 0.6,
        anticipatePin: 1,
        invalidateOnRefresh: true,
        onUpdate: function(self){
          if(self.progress > 0.002) requestShadeVideos();
          document.documentElement.classList.toggle('sv-stage-open', self.progress > 0.3);
        },
        onLeave: function(){ storyDone(); },
        onEnterBack: function(){ storyResume(); }
      }
    });
    storyTrigger = tl.scrollTrigger;
    storyTl = tl;

    /* timeline positions are on a 0-100 scale of the pinned scroll */
    tl.to(hint, { opacity: 0, duration: 4 }, 0);

    /* Act I — 0-26: the stage alone. Darkness parts, gold light floods the empty set */
    tl.to(seam, { opacity: 1, scaleX: 3, duration: 8, ease: 'power1.in' }, 0);
    tl.to(seam, { opacity: 0, duration: 10 }, 16);
    tl.to('#sv-shade-l', { xPercent: -112, skewX: -3, duration: 26, ease: 'power2.inOut' }, 4);
    tl.to('#sv-shade-r', { xPercent: 112, skewX: 3, duration: 26, ease: 'power2.inOut' }, 4);
    tl.to(glow, { scale: 1.05, opacity: 0.95, duration: 24, ease: 'power1.out' }, 6);
    tl.to(rays, { opacity: 0.4, duration: 18 }, 10);
    tl.to(vignette, { opacity: 0.35, duration: 22 }, 8);
    tl.to('#sv-backdrop', { opacity: 1, duration: 18, ease: 'none' }, 8);

    /* the opening line steps aside before the name arrives */
    tl.to(opening, { opacity: 0, y: -22, duration: 8 }, 20);

    /* Act II — 28-50: SAHASRA VASTRA assembles, filling the whole screen */
    tl.to(letters, { x: 0, y: 0, rotation: 0, scale: 1, opacity: 1, duration: 20,
      ease: 'power3.out', stagger: { each: 0.6, from: 'random' } }, 28);

    /* Act III — 52-84: the name takes its place; the rest of the scene animates in */
    tl.to(brandwrap, { y: 0, scale: 1, duration: 12, ease: 'power2.inOut' }, 52);
    tl.to(outer, { attr: { transform: 'scale(1)' }, duration: 12, ease: 'back.out(1.4)', stagger: { each: 0.35, from: 0 } }, 58);
    tl.to(inner, { attr: { transform: 'scale(1)' }, duration: 8, ease: 'back.out(1.3)', stagger: { each: 0.4, from: 0 } }, 66);
    tl.to('#sv-hub-a', { attr: { transform: 'scale(1)' }, duration: 4, ease: 'back.out(1.6)' }, 74);
    tl.to('#sv-hub-b', { attr: { transform: 'scale(1)' }, duration: 3, ease: 'back.out(1.6)' }, 76);
    tl.to(dev, { opacity: 1, y: 0, duration: 6 }, 74);
    tl.to('#sv-divider', { opacity: 1, scaleX: 1, duration: 5, ease: 'power2.out' }, 76);
    tl.to(words, { opacity: 1, y: 0, duration: 6, stagger: 1.6, ease: 'power2.out' }, 78);

    /* Act IV — 84-100: everything settles into the resting page */
    tl.to(hero, { scale: sEnd, y: yEnd, duration: 12, ease: 'power2.inOut' }, 84);
    tl.to(reveal, { y: revealY, duration: 12, ease: 'power2.inOut' }, 84);
    tl.to(vignette, { opacity: 0, duration: 10 }, 86);
    tl.to(rays, { opacity: 0.25, duration: 10 }, 86);
    tl.to('#sv-plaque', { autoAlpha: 1, y: 0, duration: 6, ease: 'power2.out' }, 86);
    tl.to('#sv-date', { autoAlpha: 1, y: 0, duration: 5, ease: 'power2.out' }, 90);
    tl.to(formWrap, { autoAlpha: 1, duration: 5, ease: 'power2.out' }, 92);
    tl.to({}, { duration: 1 }, 99); /* pad to 100 */

    ScrollTrigger.refresh();
  }

  /* the story's geometry is measured at init — re-measure when the display fonts land.
     document.fonts.status lies ("loaded") before the CSS has even requested Cinzel, so
     listen to loadingdone too, and only rebuild when the metrics actually changed */
  function fontsSettled(){
    if(storyActive && storyTrigger && storyTrigger.progress < 0.05 &&
       Math.abs(brand.offsetWidth - storyBrandW) > 2) rebuildStory();
  }
  if(document.fonts){
    if(document.fonts.ready && document.fonts.ready.then) document.fonts.ready.then(fontsSettled);
    if(document.fonts.addEventListener) document.fonts.addEventListener('loadingdone', fontsSettled);
  }
  (function(){
    var lastW = window.innerWidth, lastH = window.innerHeight, rsT = null;
    window.addEventListener('resize', function(){
      clearTimeout(rsT);
      rsT = setTimeout(function(){
        var dw = Math.abs(window.innerWidth - lastW), dh = Math.abs(window.innerHeight - lastH);
        if(dw < 2 && dh < 120) return; /* ignore mobile URL-bar jitter */
        lastW = window.innerWidth; lastH = window.innerHeight;
        if(storyActive) rebuildStory();
      }, 250);
    });
  })();

  /* ---------- pointer parallax on the stage layers ---------- */
  (function(){
    var fine = false;
    try{ fine = window.matchMedia('(pointer:fine)').matches; }catch(e){}
    if(!fine || reduced || !window.gsap) return;
    var qs = [
      { el: glow,        fx: 26, fy: 16 },
      { el: rays,        fx: 18, fy: 10 },
      { el: emblem,      fx: 12, fy: 8  },
      { el: $('sv-dust'), fx: 7, fy: 4  }
    ].map(function(t){
      return { x: gsap.quickTo(t.el, 'x', { duration: 0.9, ease: 'power2.out' }),
               y: gsap.quickTo(t.el, 'y', { duration: 0.9, ease: 'power2.out' }),
               fx: t.fx, fy: t.fy };
    });
    window.addEventListener('mousemove', function(e){
      var nx = e.clientX / window.innerWidth - 0.5,
          ny = e.clientY / window.innerHeight - 0.5;
      qs.forEach(function(q){ q.x(nx * q.fx); q.y(ny * q.fy); });
    }, { passive: true });
  })();

  /* ---------- boot ---------- */
  tick();

  var gsapReady = !!(window.gsap && window.ScrollTrigger);
  var justPosted = !!formStatus; /* the customer form was submitted (success or error) */
  /* the reveal IS the page — play it on every visit (reduced motion / no GSAP fall back to the static page) */
  var canStory = gsapReady && !reduced && !justPosted && Date.now() < TARGET;

  if(Date.now() >= TARGET){
    enterOpen();
  }else if(canStory){
    initStory();
  }else{
    /* reduced motion, no GSAP, or a fresh form submission: the finished state is the CSS default */
    startAmbient();
    if(justPosted) setTimeout(function(){
      formWrap.scrollIntoView({ behavior: 'auto', block: 'center' });
    }, 60);
  }

  }

  if(document.readyState === 'loading'){
    document.addEventListener('DOMContentLoaded', boot);
  }else{
    boot();
  }
})();
</script>

{% schema %}
{
  "name": "SV Launch",
  "settings": [
    { "type": "text", "id": "headline", "label": "Opening line", "default": "Something new is unfolding." },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Little Moments, Beautifully Dressed." },
    { "type": "text", "id": "date_text", "label": "Line under the clock", "default": "27 September · 3 PM" },
    { "type": "text", "id": "sticky_text", "label": "Sticky bar text", "default": "Opens 27 Sep · 3 PM" },
    {
      "type": "text", "id": "whatsapp_number", "label": "WhatsApp number",
      "info": "Country code plus number, no spaces. Example: 918547629251",
      "default": "918547629251"
    },
    {
      "type": "text", "id": "launch_iso", "label": "Countdown target (do not change unless the date moves)",
      "info": "Format: 2026-09-27T15:00:00+05:30 (India time)",
      "default": "2026-09-27T15:00:00+05:30"
    }
  ],
  "presets": [ { "name": "SV Launch" } ]
}
{% endschema %}

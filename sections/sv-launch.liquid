{%- comment -%}
  SV Launch — the pre-launch reveal + countdown page (password page).
  GENERATED from preview/index.html — edit the preview, then rebuild; see shopify/README.md.
{%- endcomment -%}

{% style %}
/* ============ Tokens ============ */
:root{
  --sv-emerald:#14524A;
  --sv-emerald-deep:#0A2723;
  --sv-ivory:#FBF7EF;
  --sv-cocoa:#4A3B34;
  --sv-cocoa2:#7A6A60;
  --sv-warm:#F3D9A4;
  --sv-gold:#C6A15B;
  --sv-font-latin:"Jost","Avenir Next","Century Gothic","Futura",system-ui,sans-serif;
  --sv-font-dev:"Tiro Devanagari Hindi","Noto Serif Devanagari","Kohinoor Devanagari",serif;
  --sv-font-display:"Cinzel","Cormorant Garamond",Georgia,"Times New Roman",serif;
}
*{box-sizing:border-box;margin:0;padding:0}
/* NOTE: no `scroll-behavior:smooth` here — it breaks ScrollTrigger's pin measurements;
   JS scrolls pass behavior:'smooth' explicitly instead */
html{background:#071E1B} /* overscroll/rubber-band regions blend into the page */
body{
  font-family:var(--sv-font-latin);
  font-weight:400;
  color:var(--sv-ivory);
  background:linear-gradient(180deg,#0D332D 0%,#0A2723 55%,#071E1B 100%);
  min-height:100vh;
  -webkit-font-smoothing:antialiased;
  overflow-x:hidden;
}
a{color:var(--sv-gold)}
:focus-visible{outline:2px solid var(--sv-gold);outline-offset:3px;border-radius:2px}
.sv-vh{position:absolute!important;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}
.sv-needs-js{display:none}
html.sv-js .sv-needs-js{display:revert}

/* ============ Grand stage set ============ */
:root{
  --sv-wingw:clamp(120px,16vw,300px);
}
.sv-set{position:fixed;inset:0;z-index:0;pointer-events:none;overflow:hidden}
.sv-wing{
  position:absolute;top:0;bottom:0;width:var(--sv-wingw);overflow:hidden;
  background:linear-gradient(180deg,#0D332D 0%,#0A2723 55%,#071E1B 100%);
}
.sv-wing-l{left:0}
.sv-wing-r{right:0}
/* crossed gold deco lines on the wings */
.sv-wing::before,.sv-wing::after{
  content:"";position:absolute;left:-45%;right:-45%;top:48%;height:2px;
  background:linear-gradient(90deg,rgba(198,161,91,0),rgba(198,161,91,.55),rgba(198,161,91,0));
}
.sv-wing::before{transform:rotate(52deg)}
.sv-wing::after{transform:rotate(-52deg)}
.sv-backdrop{
  position:absolute;top:0;bottom:0;
  left:calc(var(--sv-wingw) - 6px);right:calc(var(--sv-wingw) - 6px);
  background:linear-gradient(180deg,#0D332D 0%,#0A2723 55%,#071E1B 100%);
  will-change:transform,opacity;
}
.sv-threads{position:absolute;inset:0;width:100%;height:100%;opacity:.55}
@media (max-width:640px){
  :root{--sv-wingw:16px}
}

/* ============ Page shell ============ */
.sv-page{position:relative;z-index:2}
.sv-scene{
  display:flex;flex-direction:column;align-items:center;
  padding:clamp(20px,4vh,44px) 20px 40px;
  position:relative;
}
.sv-hero{
  display:flex;flex-direction:column;align-items:center;text-align:center;
  will-change:transform;position:relative;z-index:2;
}
.sv-reveal{display:flex;flex-direction:column;align-items:center;text-align:center;margin-top:clamp(24px,4vh,44px);position:relative;z-index:2}

/* story mode: scene pinned to one viewport, layers stacked */
.sv-scene.is-story{
  height:100vh;height:100svh;
  overflow:hidden;padding:0;
}
.sv-scene.is-story .sv-hero{
  position:absolute;inset:0;
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  padding:0 20px;
}
.sv-scene.is-story .sv-reveal{
  position:absolute;inset:0;margin:0;
  display:flex;flex-direction:column;align-items:center;justify-content:flex-end;
  padding:0 20px 32px;
  pointer-events:none;
}
.sv-scene.is-story .sv-reveal > *{pointer-events:auto}
.sv-scene.is-story .sv-opening{
  position:absolute;top:34vh;left:0;right:0;margin:0;z-index:8;
  font-size:clamp(1.8rem,7vw,3rem);
  color:var(--sv-ivory);
  text-shadow:0 0 26px rgba(243,217,164,.55), 0 0 60px rgba(243,217,164,.3);
  padding:0 24px;
}
.sv-scene.is-story .sv-date{margin-top:10px}

/* ============ Stage light layers ============ */
.sv-stage{position:absolute;inset:0;overflow:hidden;pointer-events:none;z-index:1}
.sv-glow{
  position:absolute;left:50%;top:38%;width:min(150vw,1200px);aspect-ratio:1;
  transform:translate(-50%,-50%);
  background:radial-gradient(closest-side,
    rgba(243,217,164,.5), rgba(243,217,164,.16) 42%, rgba(243,217,164,0) 72%);
  opacity:.85;
  will-change:transform,opacity;
}
.is-open .sv-glow{opacity:1;
  background:radial-gradient(closest-side,
    rgba(243,217,164,.95), rgba(243,217,164,.4) 46%, rgba(243,217,164,0) 74%)}
.sv-ambient-on .sv-glow{animation:sv-breathe 5s ease-in-out infinite}
@keyframes sv-breathe{0%,100%{opacity:1}50%{opacity:.7}}

.sv-rays{
  position:absolute;left:50%;top:46%;width:0;height:0;
  opacity:.3;will-change:opacity;
}
.sv-rays i{
  position:absolute;left:-4vmax;top:-70vmax;width:8vmax;height:140vmax;display:block;
  background:linear-gradient(180deg,
    rgba(243,217,164,0) 6%, rgba(243,217,164,.16) 40%,
    rgba(243,217,164,.16) 60%, rgba(243,217,164,0) 94%);
}
.sv-rays i:nth-child(1){transform:rotate(18deg)}
.sv-rays i:nth-child(2){transform:rotate(-24deg);width:5vmax;left:-2.5vmax}
.sv-rays i:nth-child(3){transform:rotate(64deg);width:4vmax;left:-2vmax}
.sv-rays-spin{position:absolute;inset:0;animation:sv-spin 90s linear infinite}
@media (prefers-reduced-motion:reduce){.sv-rays-spin{animation:none}}
@keyframes sv-spin{from{transform:rotate(0)}to{transform:rotate(360deg)}}

/* darkness that parts (story only; invisible by default) */
.sv-shade{
  position:absolute;top:-2%;bottom:-2%;width:56%;z-index:6;
  opacity:0;pointer-events:none;will-change:transform,opacity;
  overflow:hidden;
}
/* premium ambient motion video lives inside each parting shade */
.sv-shadevid{
  position:absolute;top:0;height:100%;width:100vw;
  object-fit:cover;opacity:.94;
}
/* shades sit 2vw outside the viewport; nudge the videos back so both halves align at the seam */
.sv-shade-l .sv-shadevid{left:2vw}
.sv-shade-r .sv-shadevid{right:2vw}
.sv-shade-l{left:-2%;
  background:linear-gradient(100deg, var(--sv-emerald-deep) 0%, #123A34 72%, rgba(10,39,35,0) 100%);
  -webkit-mask-image:linear-gradient(90deg,#000 0%,#000 calc(100% - 80px),rgba(0,0,0,0) 100%);
  mask-image:linear-gradient(90deg,#000 0%,#000 calc(100% - 80px),rgba(0,0,0,0) 100%)}
.sv-shade-r{right:-2%;
  background:linear-gradient(260deg, var(--sv-emerald-deep) 0%, #123A34 72%, rgba(10,39,35,0) 100%);
  -webkit-mask-image:linear-gradient(270deg,#000 0%,#000 calc(100% - 80px),rgba(0,0,0,0) 100%);
  mask-image:linear-gradient(270deg,#000 0%,#000 calc(100% - 80px),rgba(0,0,0,0) 100%)}
.sv-seam{
  position:absolute;left:50%;top:0;bottom:0;width:3px;z-index:7;
  transform:translateX(-50%);
  background:linear-gradient(180deg,
    rgba(243,217,164,0), rgba(243,217,164,.95) 22%,
    rgba(243,217,164,.95) 78%, rgba(243,217,164,0));
  box-shadow:0 0 18px 4px rgba(243,217,164,.55), 0 0 60px 18px rgba(243,217,164,.25);
  opacity:0;pointer-events:none;will-change:transform,opacity;
}
/* seam wakes up once when the story starts — CSS-only so it never fights the scrubbed timeline.
   sv-fresh is set only on fresh loads, so mid-story rebuilds don't replay the flash */
@keyframes sv-seamin{from{opacity:0}}
.sv-scene.is-story.sv-fresh .sv-seam{animation:sv-seamin 1.6s ease-out}
/* soft cinematic vignette while the story plays */
.sv-vignette{
  position:absolute;inset:0;z-index:5;pointer-events:none;opacity:0;
  background:radial-gradient(120% 90% at 50% 46%, rgba(10,39,35,0) 55%, rgba(10,39,35,.4) 100%);
  will-change:opacity;
}

/* gold dust */
.sv-dust{position:absolute;inset:0;z-index:4;pointer-events:none;display:none;overflow:hidden}
.sv-stage-open .sv-dust,.sv-ambient-on .sv-dust{display:block}
.sv-dust i{
  position:absolute;bottom:-4vh;display:block;width:5px;height:5px;border-radius:50%;
  background:rgba(198,161,91,.8);
  box-shadow:0 0 8px 2px rgba(243,217,164,.6);
  opacity:0;
  animation:sv-rise linear infinite;
}
@keyframes sv-rise{
  0%{transform:translate(0,0) scale(.7);opacity:0}
  12%{opacity:.5}
  60%{opacity:.35}
  100%{transform:translate(4vw,-108vh) scale(1.1);opacity:0}
}
@media (prefers-reduced-motion:reduce){.sv-dust{display:none!important}}

/* ============ Opening line + hint ============ */
.sv-opening{
  font-family:"Cormorant Garamond",Georgia,"Times New Roman",serif;
  font-style:italic;font-weight:400;
  font-size:clamp(1.5rem,5.5vw,2.4rem);
  letter-spacing:.06em;color:rgba(251,247,239,.85);
  margin-bottom:clamp(18px,3.2vh,32px);text-align:center;
}
.sv-hint{
  opacity:0;pointer-events:none;z-index:8;
  position:absolute;left:0;right:0;bottom:6vh;
  display:flex;flex-direction:column;align-items:center;gap:6px;
  font-size:.8rem;letter-spacing:.22em;text-transform:uppercase;
  color:rgba(251,247,239,.8);
}
.sv-scene:not(.is-story) .sv-hint{display:none}
.sv-hint svg{display:block;animation:sv-bob 1.8s ease-in-out infinite}
.sv-hint svg path{stroke:rgba(251,247,239,.8)}
@keyframes sv-bob{0%,100%{transform:translateY(0)}50%{transform:translateY(7px)}}

/* ============ Emblem ============ */
.sv-emblem{
  width:min(56vw,320px);
  will-change:transform,opacity;
}
.sv-emblem svg{display:block;width:100%;height:auto;overflow:visible}

/* ============ Brand block ============ */
.sv-brandwrap{will-change:transform;position:relative;z-index:3}
/* metallic gold letters with a travelling shine */
@supports ((-webkit-background-clip:text) or (background-clip:text)){
  .sv-brand{
    background-image:
      linear-gradient(115deg, rgba(255,252,235,0) 40%, rgba(255,252,235,1) 50%, rgba(255,252,235,0) 60%),
      linear-gradient(180deg,#FFFBE6 0%,#FAE9AE 30%,#F2C75D 54%,#DCA83E 76%,#C69233 88%,#F6E3A6 100%);
    background-size:260% 100%, 100% 100%;
    background-position:150% 0, 0 0;
    background-repeat:no-repeat;
    -webkit-background-clip:text;background-clip:text;
    color:transparent;-webkit-text-fill-color:transparent;
    text-shadow:none;
    filter:drop-shadow(0 1px 2px rgba(7,30,27,.9)) drop-shadow(0 3px 12px rgba(7,30,27,.55));
    animation:sv-brandshine 4.5s ease-in-out infinite;
  }
  /* while the story splits the name into moving letters, gild each letter instead
     (the parent's clipped background can't follow transformed spans) */
  .sv-brand:has(.sv-ltr){
    background-image:none;animation:none;filter:none;
    color:#E7C887;-webkit-text-fill-color:currentColor;
    text-shadow:0 1px 2px rgba(7,30,27,.55), 0 0 30px rgba(198,161,91,.3);
  }
  .sv-brand .sv-ltr{
    background-image:linear-gradient(180deg,#FFFBE6 0%,#FAE9AE 30%,#F2C75D 54%,#DCA83E 76%,#C69233 88%,#F6E3A6 100%);
    -webkit-background-clip:text;background-clip:text;
    color:transparent;-webkit-text-fill-color:transparent;
  }
}
@keyframes sv-brandshine{0%,40%{background-position:150% 0, 0 0}100%{background-position:-80% 0, 0 0}}
@media (prefers-reduced-motion:reduce){.sv-brand{animation:none}}
/* the emblem turns imperceptibly once the page is at rest */
.sv-ambient-on .sv-emblem svg{animation:sv-slowspin 160s linear infinite}
@keyframes sv-slowspin{to{transform:rotate(360deg)}}
@media (prefers-reduced-motion:reduce){
  .sv-ambient-on .sv-brand{animation:none}
  .sv-ambient-on .sv-emblem svg{animation:none}
}
.sv-brand{
  margin-top:clamp(-56px,-5vw,-16px); /* tucks under the emblem's transparent viewBox padding */
  line-height:1;
  font-family:var(--sv-font-display);
  font-weight:600;
  font-size:clamp(2.1rem,8.3vw,8rem);
  letter-spacing:.12em;text-indent:.12em;
  color:#E7C887;
  text-shadow:0 1px 2px rgba(7,30,27,.55), 0 0 30px rgba(198,161,91,.3);
  white-space:nowrap;text-align:center;
}
.sv-brand .sv-ltr{display:inline-block;will-change:transform,opacity}
/* sparkle glints that pop as the shine sweep crosses the name */
.sv-sparkles{position:absolute;inset:0;pointer-events:none;overflow:visible}
.sv-sparkles i{position:absolute;width:16px;height:16px;display:block;opacity:0;
  filter:drop-shadow(0 0 6px rgba(243,217,164,.9))}
.sv-sparkles svg{display:block;width:100%;height:100%}
@media (prefers-reduced-motion:reduce){.sv-sparkles{display:none}}
.sv-dev{
  font-family:var(--sv-font-dev);font-weight:400;
  font-size:clamp(1.2rem,4.2vw,1.7rem);
  color:rgba(251,247,239,.75);
  margin-top:8px;letter-spacing:.08em;text-align:center;
}
.sv-divider{
  display:flex;align-items:center;gap:12px;
  margin-top:clamp(10px,1.8vh,16px);
  width:min(58vw,290px);
  will-change:transform,opacity;
}
.sv-divider i{flex:1;height:1px;display:block}
.sv-divider i:first-child{background:linear-gradient(90deg,rgba(198,161,91,0),rgba(198,161,91,.75))}
.sv-divider i:last-child{background:linear-gradient(270deg,rgba(198,161,91,0),rgba(198,161,91,.75))}
.sv-divider span{color:var(--sv-gold);font-size:.78rem;line-height:1}
.sv-tagline{
  font-weight:300;
  font-size:clamp(1rem,3.2vw,1.3rem);
  letter-spacing:.06em;color:var(--sv-ivory);
  margin-top:clamp(12px,2vh,20px);text-align:center;
}
.sv-tagline .sv-word{display:inline-block;will-change:transform,opacity}

/* ============ Countdown plaque ============ */
.sv-plaque{
  position:relative;
  will-change:transform,opacity;
  background:linear-gradient(180deg,#124840 0%,#0A2723 100%);
  border:1px solid rgba(198,161,91,.8);
  border-radius:14px;
  padding:clamp(14px,2.4vh,22px) clamp(18px,4.5vw,40px) clamp(10px,1.8vh,16px);
  box-shadow:
    0 14px 34px rgba(7,30,27,.45),
    inset 0 0 0 3px rgba(7,30,27,.9),
    inset 0 0 0 4px rgba(198,161,91,.5);
}
.sv-colon{
  font-family:var(--sv-font-display);
  font-weight:400;font-size:clamp(1.4rem,5.2vw,2.2rem);line-height:1;
  color:var(--sv-gold);opacity:.75;
  align-self:flex-start;margin-top:.3em;
}
.sv-countdown{
  display:flex;gap:clamp(8px,2.4vw,20px);
  justify-content:center;align-items:flex-start;
  font-variant-numeric:tabular-nums;font-feature-settings:"tnum";
  will-change:transform,opacity;
  transition:transform .5s ease;
}
.sv-unit{display:flex;flex-direction:column;align-items:center;gap:6px}
.sv-digits{display:flex;font-family:var(--sv-font-display);font-weight:400;font-size:clamp(1.9rem,7vw,2.9rem);line-height:1;color:var(--sv-warm)}
.sv-digit{position:relative;width:.64em;height:1em;overflow:hidden;display:inline-block}
.sv-digit span{
  position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
  transition:transform .25s cubic-bezier(.3,.7,.25,1);
}
.sv-digit span.sv-out{transform:translateY(-105%)}
.sv-digit span.sv-in{transform:translateY(105%)}
.sv-label{font-size:.68rem;letter-spacing:.3em;text-indent:.3em;color:rgba(251,247,239,.65)}
.sv-progress{
  margin-top:clamp(8px,1.4vh,12px);height:3px;border-radius:2px;
  background:rgba(198,161,91,.22);overflow:hidden;
}
.sv-progress i{
  display:block;height:100%;width:0;border-radius:2px;
  background:linear-gradient(90deg,#C6A15B,#F3D9A4);
  box-shadow:0 0 8px rgba(243,217,164,.55);
  transition:width .6s ease;
}
.sv-countdown.is-final{transform:scale(1.05)}
.sv-countdown.is-final .sv-digits{animation:sv-pulse 1s ease-in-out infinite}
@keyframes sv-pulse{0%,100%{transform:scale(1)}30%{transform:scale(1.06)}}
.sv-reduced .sv-countdown.is-final .sv-digits{animation:none}

.sv-date{
  margin-top:clamp(14px,2.2vh,22px);
  font-weight:400;
  font-size:clamp(.9rem,2.7vw,1.1rem);
  letter-spacing:.24em;text-indent:.24em;text-transform:uppercase;
  color:var(--sv-ivory);text-align:center;
}

/* ============ Form ============ */
.sv-form-wrap{width:min(92vw,420px);margin-top:6px}
.sv-form{display:flex;flex-direction:column;gap:10px}
@media (min-width:480px){
  .sv-form{flex-direction:row}
  .sv-form input[type=email]{flex:1}
}
.sv-form input[type=email]{
  font:inherit;font-weight:300;
  padding:13px 16px;
  border:1px solid rgba(122,106,96,.45);
  border-radius:999px;
  background:var(--sv-ivory);color:var(--sv-cocoa);
  min-width:0;
}
.sv-form input[type=email]::placeholder{color:var(--sv-cocoa2)}
.sv-btn{
  font:inherit;font-weight:500;letter-spacing:.05em;
  padding:13px 24px;border-radius:999px;cursor:pointer;
  border:1px solid var(--sv-gold);
  background:linear-gradient(180deg,#E7C887,#C6A15B);color:var(--sv-emerald-deep);
  white-space:nowrap;text-decoration:none;display:inline-block;text-align:center;
  transition:opacity .2s ease;
}
.sv-btn:hover{opacity:.92}
.sv-btn-ghost{
  font:inherit;font-weight:500;letter-spacing:.05em;
  padding:9px 18px;border-radius:999px;cursor:pointer;
  border:1px solid var(--sv-gold);
  background:transparent;color:var(--sv-warm);
  text-decoration:none;white-space:nowrap;
}
.sv-consent{margin-top:10px;font-size:.8rem;font-weight:300;color:rgba(251,247,239,.6);letter-spacing:.03em;text-align:center}
.sv-success{font-size:1rem;color:var(--sv-warm);letter-spacing:.04em;padding:12px 0;text-align:center}
.sv-error{font-size:.85rem;color:#E8A896;margin-top:8px;text-align:center}

/* ============ Open state ============ */
.sv-open-block{display:none;flex-direction:column;align-items:center;gap:18px;margin-top:clamp(18px,3vh,30px)}
.is-open .sv-open-block{display:flex}
.sv-open-line{font-weight:300;font-size:clamp(1.4rem,5vw,2rem);letter-spacing:.12em;color:var(--sv-ivory)}
.is-open .sv-reveal-item{display:none}
.is-open .sv-sticky{display:none}

/* ============ Footer ============ */
.sv-footer{
  position:relative;z-index:1;
  display:flex;flex-wrap:wrap;justify-content:center;align-items:center;gap:8px 14px;
  padding:26px 20px;
  font-weight:300;font-size:.88rem;color:rgba(251,247,239,.72);letter-spacing:.05em;
  text-align:center;
  background:rgba(7,30,27,.88);
  -webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);
  border-top:1px solid rgba(198,161,91,.35);
}
.sv-social{
  flex-basis:100%;
  display:flex;justify-content:center;gap:clamp(24px,7vw,52px);
}
.sv-social a{
  display:flex;align-items:center;color:var(--sv-gold);
  transition:color .25s ease, transform .25s ease, filter .25s ease;
}
.sv-social a:hover{
  color:var(--sv-warm);transform:translateY(-2px);
  filter:drop-shadow(0 0 10px rgba(243,217,164,.55));
}
.sv-social svg{display:block;width:38px;height:38px}

/* ============ Sticky bar ============ */
.sv-sticky{
  position:fixed;left:0;right:0;bottom:0;z-index:40;
  display:flex;align-items:center;justify-content:center;gap:12px 18px;flex-wrap:wrap;
  padding:10px 16px;
  background:rgba(7,30,27,.92);
  -webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);
  border-top:1px solid rgba(198,161,91,.3);
  font-size:.88rem;letter-spacing:.05em;color:var(--sv-ivory);
  transform:translateY(0);transition:transform .35s ease;
}
.sv-sticky.is-hidden{transform:translateY(110%)}
.sv-sticky-count{font-variant-numeric:tabular-nums;color:var(--sv-warm);font-weight:500}

/* ============ Ambient falling petals ============ */
.sv-fall{position:fixed;inset:0;z-index:1;pointer-events:none;display:none;overflow:hidden}
.sv-ambient-on .sv-fall{display:block}
.sv-fall i{
  position:absolute;top:-6vh;display:block;width:13px;opacity:.12;
  animation:sv-fall linear infinite;
}
.sv-fall svg{display:block;width:100%;height:auto}
@keyframes sv-fall{
  from{transform:translateY(-8vh) rotate(0deg)}
  to{transform:translateY(112vh) rotate(200deg)}
}

/* ============ Burst petals ============ */
.sv-burst{position:absolute;left:50%;top:50%;width:0;height:0;pointer-events:none;z-index:3}
.sv-burst i{position:absolute;left:-7px;top:-10px;width:14px;display:block}
.sv-burst svg{display:block;width:100%;height:auto}

/* ============ Reduced motion ============ */
@media (prefers-reduced-motion:reduce){
  .sv-hint svg,.sv-glow,.sv-countdown.is-final .sv-digits{animation:none!important}
  .sv-fall{display:none!important}
  .sv-progress i{transition:none}
  .sv-digit span{transition:none}
  .sv-sticky{transition:none}
}


{%- comment -%}
  Customer reviews — a host for a reviews app's theme block (Judge.me,
  Loox and the like all ship an "@app" block). The theme holds no review
  data of its own and never invents any: with no app block added, this
  section renders nothing — ARCHITECTURE §27.2, no heading, no empty
  state, no placeholder stars.

  Setup: install the reviews app → Online Store → Customize → Product
  page → this section → Add block → the app's "Reviews widget".
{%- endcomment -%}

{%- if section.blocks.size > 0 -%}
  <section class="sv-reviews" data-sv>
    <div class="w">
      {%- if section.settings.heading != blank -%}
        <h2 class="sv-reviews__h">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- for block in section.blocks -%}
        {% render block %}
      {%- endfor -%}
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  section[data-sv].sv-reviews {
    padding: var(--d) 0 0;
  }

  [data-sv] .sv-reviews__h {
    margin: 0 0 var(--c);
    text-align: center;
    font-family: var(--serif);
    font-size: clamp(1.8rem, 3.4vw, 2.6rem);
    font-weight: 500;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "SV Reviews",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Customer reviews" }
  ],
  "blocks": [{ "type": "@app" }],
  "presets": [{ "name": "SV Reviews" }]
}
{% endschema %}

  /* ── desktop dropdowns (Phase 1.2) ─────────────────────────────────────
     CSS owns opening — hover and :focus-within — so the children reach a
     no-JS reader; the JS below only mirrors aria-expanded and adds Escape.
     .is-closed is that JS's override: without it, refocusing the parent
     button after Escape would re-open the panel through :focus-within. */
  .sv-hero-video__navitem { position: relative; display: flex; }

  [data-sv] .sv-hero-video__navlink--parent {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: none;
    border: 0;
    cursor: pointer;
  }
  .sv-hero-video__navcaret {
    width: 13px;
    height: 13px;
    transition: transform 0.3s ease;
  }
  .sv-hero-video__navitem:not(.is-closed):hover .sv-hero-video__navcaret,
  .sv-hero-video__navitem:not(.is-closed):focus-within .sv-hero-video__navcaret {
    transform: rotate(180deg);
  }

  [data-sv] .sv-hero-video__navsub {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    z-index: 96;
    min-width: max-content;
    margin: 0;
    /* The 10px bridge keeps the pointer inside the item on the way down,
       padded rather than gapped so hover never breaks mid-travel. */
    padding: 10px 0 0;
    list-style: none;
  }
  .sv-hero-video__navsub > li {
    background: rgba(26, 26, 26, 0.66);
    -webkit-backdrop-filter: blur(18px);
    backdrop-filter: blur(18px);
    border-inline: 1px solid rgba(251, 247, 239, 0.22);
  }
  .sv-hero-video__navsub > li:first-child {
    border-top: 1px solid rgba(251, 247, 239, 0.22);
    border-radius: 18px 18px 0 0;
    padding-top: 8px;
  }
  .sv-hero-video__navsub > li:last-child {
    border-bottom: 1px solid rgba(251, 247, 239, 0.22);
    border-radius: 0 0 18px 18px;
    padding-bottom: 8px;
  }
  .sv-hero-video__navitem:not(.is-closed):hover .sv-hero-video__navsub,
  .sv-hero-video__navitem:not(.is-closed):focus-within .sv-hero-video__navsub {
    display: block;
  }

  [data-sv] .sv-hero-video__navsub-link {
    display: block;
    padding: 11px 26px;
    font-family: var(--sans);
    font-weight: 600;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--cream);
    text-decoration: none;
  }
  [data-sv] .sv-hero-video__navsub-link:hover,
  [data-sv] .sv-hero-video__navsub-link:focus-visible {
    background: rgba(251, 247, 239, 0.16);
  }

  /* Two panes: ages down the column, the read age's sizes beside them. */
  .sv-hero-video__navgroup {
    position: relative;
  }

  [data-sv] .sv-hero-video__navsub--split .sv-hero-video__navsub-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
  }

  .sv-hero-video__navarrow {
    inline-size: 12px;
    block-size: 12px;
    opacity: 0.65;
    flex: none;
  }

  .sv-hero-video__navflyout {
    display: none;
    position: absolute;
    top: -8px;
    left: 100%;
    margin-left: 10px;
    z-index: 97;
    width: max-content;
    /* Wide enough for a whole age's run on one line. */
    max-width: 480px;
    padding: 14px 18px 16px;
    border-radius: 18px;
    background: rgba(26, 26, 26, 0.72);
    -webkit-backdrop-filter: blur(18px);
    backdrop-filter: blur(18px);
    border: 1px solid rgba(251, 247, 239, 0.22);

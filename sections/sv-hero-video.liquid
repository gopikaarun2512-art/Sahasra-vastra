{%- comment -%}
  Homepage hero — film variant. ARCHITECTURE.md §6.3 planned the wardrobe
  hero as a CSS 3D door trick over a still; this section supersedes it with
  the brand film, whose first shot IS the wardrobe doors opening. Same
  settings contract as §6.3 (eyebrow, heading with one <em>, body, two
  actions), copy defaults from CONTENT.md §02.1.

  The film is hosted off-theme (CloudFront) — a 26 MB asset does not belong
  in the theme bundle. Poster is the LCP element: eager, preloaded when the
  section is first on the page. The video autoplays muted and looped; a
  pause control satisfies WCAG 2.2.2, and prefers-reduced-motion holds on
  the poster frame instead of playing.
{%- endcomment -%}

{%- liquid
  assign poster_src = section.settings.poster_url
  if section.settings.poster != blank
    assign poster_src = section.settings.poster | image_url: width: 1920
  endif
  assign nav_menu = linklists[section.settings.menu]
-%}

{%- if section.index == 1 and poster_src != blank -%}
  <link rel="preload" as="image" href="{{ poster_src }}" fetchpriority="high">
{%- endif -%}

<section class="sv-hero-video sv-hero-video--{{ section.settings.height }}" data-sv {% if section.settings.float_nav %}data-float-nav{% endif %} style="--overlay-o: {{ section.settings.overlay_opacity | divided_by: 100.0 }}">
  <video
    class="sv-hero-video__media"
    id="sv-hero-video-{{ section.id }}"
    muted
    loop
    playsinline
    preload="metadata"
    {% if poster_src != blank %}poster="{{ poster_src }}"{% endif %}
    data-src-desktop="{{ section.settings.video_url_desktop | escape }}"
    data-src-mobile="{{ section.settings.video_url_mobile | escape }}"
    aria-hidden="true"
    tabindex="-1"
  ></video>

  {%- comment -%}
    Source is chosen here, inline, before the parser reaches the next
    element: exactly one file downloads, the right one for the viewport,
    and with scripting unavailable the poster stands in. `muted` must also
    be set as a property — some engines ignore the attribute alone when
    play() is called from script.
  {%- endcomment -%}
  <script>
    (function () {
      var v = document.getElementById('sv-hero-video-{{ section.id }}');
      if (!v) return;
      var sec = v.closest('.sv-hero-video');
      var setChrome = function () {
        var hg = document.getElementById('header-group');
        if (sec && hg) sec.style.setProperty('--sv-chrome-h', hg.offsetHeight + 'px');
      };
      setChrome();
      window.addEventListener('resize', setChrome);
      /* The hero owns the first screen, so its entrance must not depend on
         sv-motion's IntersectionObserver: observers stay silent in hidden
         tabs, and a failed script would leave the lockup at opacity 0
         forever. A timer still lets the staggered transition play. */
      setTimeout(function () {
        if (sec) sec.querySelectorAll('.rv').forEach(function (el) { el.classList.add('in'); });
      }, 60);
      /* §4 performance rule: on Save-Data or a 2g/3g connection the film
         never downloads — the poster stands in. */
      var conn = navigator.connection || {};
      if (conn.saveData || /(^|\b)(slow-)?(2g|3g)$/.test(conn.effectiveType || '')) return;
      var mobile = v.dataset.srcMobile;
      var src = (mobile && window.matchMedia('(max-width: 749px)').matches) ? mobile : v.dataset.srcDesktop;
      if (!src) return;
      v.src = src;
      v.muted = true;
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        v.autoplay = true;
        var tryPlay = function () {
          if (v.paused && !v.dataset.userPaused) v.play().catch(function () {});
        };
        tryPlay();
        v.addEventListener('loadeddata', tryPlay, { once: true });
        document.addEventListener('visibilitychange', function () {
          if (!document.hidden) tryPlay();
        });
      }
    })();
  </script>

  <div class="sv-hero-video__scrim" aria-hidden="true"></div>

  {%- comment -%}
    The floating pill nav — rendered while this section opts in via
    data-float-nav, which also hides the standard header and announcement
    on this page at every width. Desktop shows the full link row; below
    880px it compacts to emblem + menu/search/cart pills, with the menu
    pill opening its own fullscreen <details> sheet.
  {%- endcomment -%}
  {%- if section.settings.float_nav and nav_menu != blank -%}
    {%- comment -%}
      The delivery announcement strip that sat here (Phase 1.1) was removed
      at the owner's direction — the homepage now opens on the film with
      nothing above it. The standard bar had already been taken out of
      header-group.json for the same reason. snippets/sv-announcement-line
      and sections/sv-announcement are left in place: the line still has one
      source composed from the shop metafields, ready if the bar is ever
      wanted back, on this page or anywhere else.
    {%- endcomment -%}
    <div class="sv-hero-video__chrome">
    <div class="sv-hero-video__nav">
      <div class="sv-hero-video__navgroup">
        <a class="sv-hero-video__navpill sv-hero-video__navpill--logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
          {%- comment -%}
            Below 64px the 24-petal emblem blurs; the 8-path simple variant
            is the same mark drawn for small sizes (brand system §2).
          {%- endcomment -%}
          <img src="{{ 'emblem-simple-colour.svg' | asset_url }}" alt="" width="52" height="52">
        </a>

        <nav class="sv-hero-video__navpill sv-hero-video__navlinks" aria-label="{{ nav_menu.title | escape }}">
          {%- for link in nav_menu.links -%}
            {%- if link.links.size > 0 -%}
              {%- comment -%}
                Phase 1.2 — a parent with children is a BUTTON on desktop,
                never a link to /collections/all. The panel opens on hover
                and on keyboard focus through CSS alone (:hover /
                :focus-within), so navigation works with scripting off;
                the section's JS only mirrors state into aria-expanded and
                adds Escape-to-close.
              {%- endcomment -%}
              <div class="sv-hero-video__navitem" data-navitem>
                <button
                  type="button"
                  class="sv-hero-video__navlink sv-hero-video__navlink--parent"
                  aria-expanded="false"
                  aria-controls="sv-navsub-{{ section.id }}-{{ forloop.index }}"
                >
                  <span class="roll">
                    <span>{{ link.title }}</span>
                    <span aria-hidden="true">{{ link.title }}</span>
                  </span>
                  <svg class="sv-hero-video__navcaret" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                    <path fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" d="m7 10 5 5 5-5" />
                  </svg>
                </button>
                {%- comment -%}
                  Shop by Age carries a third level. Stacking every size
                  under every age ran the panel down most of the film, so
                  the ages hold the column and the sizes fly out beside
                  the age being read — the same two panes as the ink
                  header, in the hero's glass. A menu without a third
                  level is untouched.
                {%- endcomment -%}
                {%- liquid
                  assign split = false
                  for child in link.links
                    if child.links.size > 0
                      assign split = true
                      break
                    endif
                  endfor
                -%}
                <ul class="sv-hero-video__navsub{% if split %} sv-hero-video__navsub--split{% endif %}" id="sv-navsub-{{ section.id }}-{{ forloop.index }}">
                  {%- for child in link.links -%}
                    <li class="sv-hero-video__navgroup{% if forloop.first %} is-first{% endif %}">
                      <a class="sv-hero-video__navsub-link" href="{{ child.url }}" {% if child.current %}aria-current="page"{% endif %}>
                        {{ child.title }}
                        {%- if child.links.size > 0 -%}
                          <svg class="sv-hero-video__navarrow" viewBox="0 0 12 12" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 2.5L8 6l-3.5 3.5"/></svg>
                        {%- endif -%}
                      </a>
                      {%- if child.links.size > 0 -%}
                        <div class="sv-hero-video__navflyout">
                          <p class="sv-hero-video__navflyout-head">{{ child.title }}</p>
                          <ul class="sv-hero-video__navchips" aria-label="{{ child.title | escape }}">
                            {%- for grandchild in child.links -%}
                              <li><a class="sv-hero-video__navchip" href="{{ grandchild.url }}">{{ grandchild.title }}</a></li>
                            {%- endfor -%}
                          </ul>
                        </div>
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- else -%}
              <a class="sv-hero-video__navlink" href="{{ link.url }}" aria-label="{{ link.title | escape }}" {% if link.current %}aria-current="page"{% endif %}>
                <span class="roll">
                  <span>{{ link.title }}</span>
                  <span aria-hidden="true">{{ link.title }}</span>
                </span>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </nav>
      </div>

      <div class="sv-hero-video__navside">
        <details class="sv-hero-video__mnav">
          <summary class="sv-hero-video__navpill sv-hero-video__navpill--icon" aria-label="{{ 'accessibility.menu' | t | default: 'Menu' }}">
            {% render 'sv-icon', name: 'menu', class: 'sv-hero-video__mnav-open' %}
            {% render 'sv-icon', name: 'close', class: 'sv-hero-video__mnav-close' %}
          </summary>
          <nav class="sv-hero-video__sheet" aria-label="{{ nav_menu.title | escape }}">
            <ul class="sv-hero-video__sheet-list">
              {%- for link in nav_menu.links -%}
                <li>
                  <a class="sv-hero-video__sheet-link" href="{{ link.url }}">{{ link.title }}</a>
                  {%- if link.links.size > 0 -%}
                    <ul class="sv-hero-video__sheet-sub">
                      {%- for child in link.links -%}
                        <li>
                          <a class="sv-hero-video__sheet-child" href="{{ child.url }}">{{ child.title }}</a>
                          {%- if child.links.size > 0 -%}
                            <ul class="sv-hero-video__navchips sv-hero-video__navchips--sheet" aria-label="{{ child.title | escape }}">
                              {%- for grandchild in child.links -%}
                                <li><a class="sv-hero-video__navchip" href="{{ grandchild.url }}">{{ grandchild.title }}</a></li>
                              {%- endfor -%}
                            </ul>
                          {%- endif -%}
                        </li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </li>
              {%- endfor -%}
              {%- comment -%}
                As in sv-header's sheet: the phone's full navigation
                carries the account door, labelled by state.
              {%- endcomment -%}
              <li>
                <a class="sv-hero-video__sheet-link" href="{{ routes.root_url | append: 'pages/wishlist' | replace: '//', '/' }}">Wishlist</a>
              </li>
              <li>
                <a class="sv-hero-video__sheet-link" href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}">
                  {%- if customer -%}
                    {{ 'accessibility.account' | t | default: 'Account' }}
                  {%- else -%}
                    {{ 'actions.log_in' | t | default: 'Sign in' }}
                  {%- endif -%}
                </a>
              </li>
            </ul>
          </nav>
        </details>
        {%- if section.settings.nav_cta_label != blank -%}
          <a class="sv-hero-video__navpill sv-hero-video__navpill--cta" href="{{ section.settings.nav_cta_url | default: routes.all_products_collection_url }}">{{ section.settings.nav_cta_label }}</a>
        {%- endif -%}
        <a class="sv-hero-video__navpill sv-hero-video__navpill--icon" href="{{ routes.search_url }}" aria-label="{{ 'accessibility.search' | t | default: 'Search' }}">
          {% render 'sv-icon', name: 'search' %}
        </a>
        {%- comment -%}
          Account entry, matching sv-header's roundel (new customer
          accounts: both routes land on the hosted passwordless pages at
          account.sahasravastra.com). Desktop only — the phone's bottom
          bar and menu sheet already carry Account.
        {%- endcomment -%}
        <a class="sv-hero-video__navpill sv-hero-video__navpill--icon sv-hero-video__navpill--account" href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" aria-label="{% if customer %}{{ 'accessibility.account' | t | default: 'Account' }}{% else %}{{ 'actions.log_in' | t | default: 'Sign in' }}{% endif %}">
          {% render 'sv-icon', name: 'account' %}
        </a>
        {% render 'sv-saved-link', class: 'sv-hero-video__navpill sv-hero-video__navpill--icon sv-hero-video__navpill--account' %}
        <a class="sv-hero-video__navpill sv-hero-video__navpill--icon" href="{{ routes.cart_url }}" aria-label="{{ 'accessibility.cart_count' | t: count: cart.item_count | default: 'Cart' }}">
          {% render 'sv-icon', name: 'cart' %}
          {%- if cart.item_count > 0 -%}
            <span class="sv-hero-video__navcount" aria-hidden="true">{{ cart.item_count }}</span>
          {%- endif -%}
        </a>
      </div>
    </div>
    </div>
  {%- endif -%}

  <div class="w w--wide sv-hero-video__layout">
    <div class="sv-hero-video__content">
      {%- if section.settings.show_lockup -%}
        <div class="sv-hero-video__lockup-row rv">
          {% render 'sv-lockup', class: 'sv-hero-video__lockup', title: shop.name %}
        </div>
        {%- if section.settings.heading == blank -%}
          <h1 class="sv-visually-hidden">{{ shop.name }}{% if section.settings.eyebrow != blank %} — {{ section.settings.eyebrow }}{% endif %}</h1>
        {%- endif -%}
      {%- endif -%}

      {%- if section.settings.eyebrow != blank -%}
        <p class="sv-fine sv-fine--caps sv-hero-video__eyebrow rv">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="sv-hero-video__heading rv">{{ section.settings.heading | replace: '<p>', '' | replace: '</p>', '' }}</h1>
      {%- endif -%}

      {%- if section.settings.body != blank -%}
        <p class="sv-hero-video__body rv">{{ section.settings.body }}</p>
      {%- endif -%}

      {%- if section.settings.cta_label != blank or section.settings.secondary_label != blank or section.settings.tertiary_label != blank -%}
        <div class="sv-hero-video__actions rv">
          {%- if section.settings.cta_label != blank -%}
            <a class="btn btn--ivory" href="{{ section.settings.cta_url | default: '#' }}">{{ section.settings.cta_label }}</a>
          {%- endif -%}
          {%- if section.settings.secondary_label != blank -%}
            <a class="btn sv-hero-video__ghost" href="{{ section.settings.secondary_url | default: '#' }}">{{ section.settings.secondary_label }}</a>
          {%- endif -%}
          {%- if section.settings.tertiary_label != blank -%}
            <a class="btn sv-hero-video__glassbtn" href="{{ section.settings.tertiary_url | default: '#' }}">{{ section.settings.tertiary_label }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <aside class="sv-hero-video__cards{% if section.settings.auto_scroll %} is-marquee{% else %} rv{% endif %}" aria-label="Featured">
        <div class="sv-hero-video__cards-track">
          {%- for block in section.blocks -%}
            {%- liquid
              assign c = block.settings.collection
              assign card_title = block.settings.title
              if card_title == blank and c != blank
                assign card_title = c.title
              endif
              assign card_url = block.settings.link
              if card_url == blank and c != blank
                assign card_url = c.url
              endif
              assign card_img = block.settings.image
              if card_img == blank and c != blank
                assign card_img = c.featured_image
              endif
            -%}
            <a class="sv-hero-video__card{% unless section.settings.auto_scroll %} rv{% endunless %}" href="{{ card_url | default: '#' }}" {{ block.shopify_attributes }}>
              <span class="sv-hero-video__card-media">
                {%- if card_img != blank -%}
                  {{ card_img | image_url: width: 360 | image_tag: loading: 'lazy', widths: '180,360', sizes: '104px', alt: '' }}
                {%- else -%}
                  {{ 'collection-1' | placeholder_svg_tag: 'sv-hero-video__card-ph' }}
                {%- endif -%}
              </span>
              <span class="sv-hero-video__card-copy">
                <span class="sv-hero-video__card-title">{{ card_title }}</span>
                {%- if block.settings.text != blank -%}
                  <span class="sv-hero-video__card-text">{{ block.settings.text }}</span>
                {%- endif -%}
              </span>
            </a>
          {%- endfor -%}

        </div>
      </aside>
    {%- endif -%}
  </div>

  <button
    type="button"
    class="sv-hero-video__toggle"
    data-hero-toggle
    aria-label="Pause the film"
    aria-pressed="false"
  >
    <svg class="sv-hero-video__glyph sv-hero-video__glyph--pause" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
      <path fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" d="M9 6.5v11M15 6.5v11" />
    </svg>
    <svg class="sv-hero-video__glyph sv-hero-video__glyph--play" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
      <path fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" d="M8.5 6.2v11.6l9.4-5.8Z" />
    </svg>
  </button>

  {%- comment -%}
    Phase 1.7 — WCAG 2.2.2: the card rail auto-steps for longer than five
    seconds, so it needs its own visible pause control; the film's button
    does not stop it. 44px hit area, works on touch. Hidden on phones
    (where the rail is static native scroll) and under reduced motion
    (where the rail never moves).
  {%- endcomment -%}
  {%- if section.settings.auto_scroll and section.blocks.size > 1 -%}
    <button
      type="button"
      class="sv-hero-video__toggle sv-hero-video__toggle--rail"
      data-rail-toggle
      aria-label="Pause the card rail"
      aria-pressed="false"
    >
      <svg class="sv-hero-video__glyph sv-hero-video__glyph--pause" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
        <rect x="6" y="6.5" width="4.6" height="11" rx="1" fill="none" stroke="currentColor" stroke-width="1.4" />
        <rect x="13.4" y="6.5" width="4.6" height="11" rx="1" fill="none" stroke="currentColor" stroke-width="1.4" />
      </svg>
      <svg class="sv-hero-video__glyph sv-hero-video__glyph--play" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
        <path fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" d="M8.5 6.2v11.6l9.4-5.8Z" />
      </svg>
    </button>
  {%- endif -%}
</section>

{% stylesheet %}
  [data-sv].sv-hero-video {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: stretch;
    background: var(--cream-2);
    /* The system gives every section --g of breathing room; a full-bleed
       film hero owns its edges instead. */
    padding-block: 0;
  }

  /* When the hero opts into the floating nav, the announcement strip
     stands down on this page at every width — the pill nav carries its
     own compact mobile form with a menu sheet, so nothing is lost. */
  body:has([data-sv][data-float-nav].sv-hero-video) .sv-announcement {
    display: none;
  }

  /* The standard header stands BY rather than down. The hero's glass
     chrome is fixed at z 90 — but §08b pins the hero as a z-0 layer, and
     a stacking context holds its children under the arriving page no
     matter their own z-index. So the chrome is covered the moment the
     curtain reaches the top of the screen, and at exactly that moment
     the sv-header — fixed here, riding in #header-group's z 60, OUTSIDE
     the pinned layer — fades in and takes over: one continuous chrome,
     glass over the film, emerald pills over the ivory. The hand-off
     class comes from the observer in this section's javascript. Fixed
     rather than the group's own sticky flow so un-hiding it mid-scroll
     adds no height at the top of the document. */
  body:has([data-sv][data-float-nav].sv-hero-video) .sv-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    visibility: hidden;
    opacity: 0;
    transform: translateY(-12px);
    transition: opacity 0.4s var(--e), transform 0.4s var(--e), visibility 0s 0.4s;
  }
  body.sv-curtained:has([data-sv][data-float-nav].sv-hero-video) .sv-header {
    visibility: visible;
    opacity: 1;
    transform: none;
    transition: opacity 0.4s var(--e), transform 0.4s var(--e);
  }

  /* The fixed chrome. It stays a flex column — it carried the announcement
     strip above the pill row until that was removed, and a column is still
     the right shape for anything that needs to sit above the pills. */
  .sv-hero-video__chrome {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 90;
    display: flex;
    flex-direction: column;
  }

  /* The reference geometry: the mark and the menu sit as a left cluster,
     the actions cluster holds the right edge, generous inset all round. */
  .sv-hero-video__nav {
    position: relative;
    margin: var(--b) var(--c) 0;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: var(--a);
  }

  /* Compact form below 1180 (was 880 — measured Sep 2026: with the
     Wishlist pill in the cluster the full link row overran the pills by
     126px at 1280 and 380px at 1000). Emblem left; menu, search, wishlist
     and cart pills right. The link row and catalogue pill are desktop
     company. */
  @media (max-width: 1179px) {
    .sv-hero-video__nav {
      margin: var(--a) var(--a) 0;
    }
    [data-sv] .sv-hero-video__navlinks,
    [data-sv] .sv-hero-video__navpill--cta,
    [data-sv] .sv-hero-video__navpill--account { display: none; }
    /* Kills the desktop centring transform, which would otherwise become
       the fixed-position containing block for the fullscreen menu sheet. */
    [data-sv] .sv-hero-video__nav .sv-hero-video__navside {
      position: static;
      transform: none;
      margin-inline-start: auto;
    }
  }

  .sv-hero-video__mnav { position: relative; }
  @media (min-width: 1180px) {
    .sv-hero-video__mnav { display: none; }
  }

  /* Narrow desktop: tighten the link row so it clears the pill cluster
     (the same step sv-header takes). */
  @media (min-width: 1180px) and (max-width: 1560px) {
    /* Out-ranks the base [data-sv] .sv-hero-video__navlink further down. */
    [data-sv] .sv-hero-video__navlinks .sv-hero-video__navlink {
      padding: 13px 13px;
      /* Steps down from the 0.85rem base, never below the old size. */
      font-size: 0.78rem;
      letter-spacing: 0.1em;
    }
  }
  .sv-hero-video__mnav > summary {
    list-style: none;
    position: relative;
    z-index: 96;
    cursor: pointer;
  }
  .sv-hero-video__mnav > summary::-webkit-details-marker { display: none; }
  .sv-hero-video__mnav:not([open]) .sv-hero-video__mnav-close,
  .sv-hero-video__mnav[open] .sv-hero-video__mnav-open { display: none; }
  .sv-hero-video__mnav[open] > summary {
    background: var(--cream);
    color: var(--ink);
  }

  .sv-hero-video__sheet {
    position: fixed;
    inset: 0;
    z-index: 95;
    background: var(--cream);
    color: var(--ink);
    padding: var(--f) var(--b) var(--d);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .sv-hero-video__sheet-list { list-style: none; margin: 0; padding: 0; }
  .sv-hero-video__sheet-list > li + li { margin-top: var(--b); }
  [data-sv] .sv-hero-video__sheet-link {
    font-family: var(--serif);
    font-size: 1.5rem;
    color: var(--ink);
    text-decoration: none;
  }
  .sv-hero-video__sheet-sub { list-style: none; margin: var(--a) 0 0; padding: 0; }
  [data-sv] .sv-hero-video__sheet-child {
    display: block;
    padding: calc(var(--a) / 2) 0;
    font-family: var(--sans);
    color: var(--grey, #6b6b6b);
    text-decoration: none;
  }
  [data-sv] .sv-hero-video__sheet-child:hover { color: var(--ink); }

  .sv-hero-video__navgroup {
    display: flex;
    align-items: stretch;
    gap: var(--a);
  }

  /* WhatsApp float parks under the cart pill while the pill nav owns the
     top of the page — bottom-right is where the card rail lives now. */
  @media (min-width: 880px) {
    body:has([data-sv][data-float-nav].sv-hero-video) .float {
      bottom: auto;
      /* The pill row's own offset: its top margin, its height, one gap.
         The 32px that used to lead this sum was the announcement strip,
         and came off with it. */
      top: calc(var(--b) + 54px + var(--a));
      right: calc(var(--b) + 2px);
      align-items: center;
      transition: top 0.4s var(--e);
    }

    /* Once the curtain hands the chrome to the fixed sv-header, its
       roundels occupy the very spot the float was parked in. The float
       steps down below the header's band (padding + 68px mark + padding
       + one --a gap) and stays at the screen's own right gutter — an
       earlier cut aligned it under the cart's centre line, which put
       the column on top of the content on wide screens (owner's call,
       Sep 2026: back to the edge). */
    body.sv-curtained:has([data-sv][data-float-nav].sv-hero-video) .float {
      /* Tucked into the corner with the roundels: half a gap under the
         header's band, and 16px in so the 50px marks share the 54px
         cart's centre line (the cluster sits at 14px). */
      top: calc(var(--a) * 2 + 68px + 8px);
      right: var(--a);

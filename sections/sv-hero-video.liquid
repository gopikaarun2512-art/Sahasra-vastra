  .sv-hero-video__navgroup:hover > .sv-hero-video__navflyout,
  .sv-hero-video__navgroup:focus-within > .sv-hero-video__navflyout,
  .sv-hero-video__navsub--split:not(:hover):not(:focus-within) .sv-hero-video__navgroup.is-first > .sv-hero-video__navflyout {
    display: block;
  }

  [data-sv] .sv-hero-video__navgroup:hover > .sv-hero-video__navsub-link,
  [data-sv] .sv-hero-video__navgroup:focus-within > .sv-hero-video__navsub-link,
  [data-sv] .sv-hero-video__navsub--split:not(:hover):not(:focus-within) .sv-hero-video__navgroup.is-first > .sv-hero-video__navsub-link {
    background: rgba(251, 247, 239, 0.16);
  }

  .sv-hero-video__navflyout-head {
    margin: 0 0 10px;
    font-family: var(--sans);
    font-weight: 600;
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(251, 247, 239, 0.6);
  }

  /* Third level: size chips, on one line per age inside the flyout. */
  [data-sv] .sv-hero-video__navchips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* In the phone sheet the chips keep their old stacked run. */
  [data-sv] .sv-hero-video__navchips--sheet {
    max-width: 280px;
    padding: 0 26px 12px;
  }
  [data-sv] .sv-hero-video__navchip {
    display: block;
    padding: 5px 12px;
    border-radius: 999px;
    border: 1px solid rgba(251, 247, 239, 0.4);
    font-family: var(--sans);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--cream);
    text-decoration: none;
    transition: background 0.3s ease, color 0.3s ease;
  }
  [data-sv] .sv-hero-video__navchip:hover,
  [data-sv] .sv-hero-video__navchip:focus-visible {
    background: var(--cream);
    color: var(--ink);
  }
  /* On the cream phone sheet the chips take ink. */
  [data-sv] .sv-hero-video__navchips--sheet {
    max-width: none;
    padding: 0 0 var(--a);
  }
  [data-sv] .sv-hero-video__navchips--sheet .sv-hero-video__navchip {
    border-color: rgba(26, 26, 26, 0.2);
    color: var(--ink);
  }
  [data-sv] .sv-hero-video__navchips--sheet .sv-hero-video__navchip:hover {
    background: var(--emerald);
    color: var(--cream);
  }

  .sv-hero-video__navpill {
    display: flex;
    align-items: center;
    border-radius: 999px;
    background: rgba(26, 26, 26, 0.32);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(251, 247, 239, 0.22);
    color: var(--cream);
    text-decoration: none;
  }

  /* The mark stands alone — no pill, no ground. On hover the thousand-petal
     rosette turns on its own axis, the one animation only a radial mark can do. */
  .sv-hero-video__navpill--logo {
    flex: 0 0 auto;
    width: 60px;
    height: 60px;
    justify-content: center;
    background: none;
    border: 0;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }
  .sv-hero-video__navpill--logo img {
    width: 56px;
    height: 56px;
    display: block;
    transition: transform 0.7s var(--e, ease);
  }
  .sv-hero-video__navpill--logo:hover img { transform: rotate(120deg) scale(1.06); }
  @media (prefers-reduced-motion: reduce) {
    .sv-hero-video__navpill--logo:hover img { transform: none; }
  }

  [data-sv] .sv-hero-video__navlinks {
    padding: 7px;
    gap: 2px;
  }

  [data-sv] .sv-hero-video__navpill--cta {
    height: 54px;
    padding-inline: 28px;
    align-items: center;
    font-family: var(--sans);
    font-weight: 600;
    font-size: 0.76rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cream);
  }
  [data-sv] .sv-hero-video__navpill--cta:hover {
    background: var(--cream);
    color: var(--ink);
  }

  /* No permanent highlight — the pill fills and the label rolls only under
     the pointer, the current page marked for assistive tech alone. */
  [data-sv] .sv-hero-video__navlink {
    font-family: var(--sans);
    font-weight: 600;
    /* Set to the hero cards' own text size (0.85rem): the tabs and the
       cards sit on the same film, and the tabs reading two steps smaller
       made the row look like fine print beside them. */
    font-size: 0.85rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1.15;
    color: var(--cream);
    text-decoration: none;
    padding: 15px 24px;
    border-radius: 999px;
    transition: background 0.3s ease, color 0.3s ease;
    white-space: nowrap;
  }
  [data-sv] .sv-hero-video__navlink:hover,
  [data-sv] .sv-hero-video__navlink:focus-visible {
    background: var(--cream);
    color: var(--ink);
  }

  /* The roll fires from anywhere on the pill, not only over the letters. */
  [data-sv] .sv-hero-video__navlink:hover .roll > span,
  [data-sv] .sv-hero-video__navlink:focus-visible .roll > span {
    transform: translateY(-1.15em);
  }

  .sv-hero-video__navside {
    display: flex;
    gap: var(--a);
    flex: 0 0 auto;
    position: absolute;
    /* Pulled past the nav's inset so the cart's centre line matches the
       social float below it: cart centre = float centre = 55px from edge. */
    right: -20px;
    top: 50%;
    transform: translateY(-50%);
  }

  .sv-hero-video__navpill { transition: background 0.3s ease, color 0.3s ease, transform 0.3s ease; }

  .sv-hero-video__navpill--icon {
    width: 54px;
    height: 54px;
    justify-content: center;
    position: relative;
  }
  .sv-hero-video__navpill--icon svg { width: 22px; height: 22px; }
  .sv-hero-video__navpill--icon:hover { background: rgba(26, 26, 26, 0.55); }

  .sv-hero-video__navcount {
    position: absolute;
    top: -2px;
    right: -2px;
    min-width: var(--a);
    text-align: center;
    border-radius: 999px;
    background: var(--emerald);
    color: var(--cream);
    font-family: var(--sans);
    font-size: 0.65rem;
    line-height: var(--a);
  }

  /* The visible chrome above the hero (announcement + header, measured by
     the bootstrap script) comes off the height, so the hero — card strip
     included — fits the first screen exactly. Desktop hides that chrome
     under the floating nav, so the subtraction resolves to zero there. */
  /* --sv-bbar is the mobile bottom bar's height (set on body by sv-footer,
     phones only) — subtracted so the card rail rests above the bar, not
     underneath it. */
  .sv-hero-video--full { min-height: calc(100svh - var(--sv-chrome-h, 0px) - var(--sv-bbar, 0px)); }
  .sv-hero-video--tall { min-height: calc(82svh - var(--sv-chrome-h, 0px) - var(--sv-bbar, 0px)); }
  .sv-hero-video--standard { min-height: calc(64svh - var(--sv-chrome-h, 0px) - var(--sv-bbar, 0px)); }

  .sv-hero-video__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Legibility floor for ivory type; strength is the section's one dial.
     A gradient, not a wash — the film stays visible where the text is not. */
  .sv-hero-video__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgba(26, 26, 26, var(--overlay-o)) 0%, rgba(26, 26, 26, 0) 60%),
      linear-gradient(105deg, rgba(26, 26, 26, calc(var(--overlay-o) * 0.85)) 0%, rgba(26, 26, 26, 0) 55%);
    pointer-events: none;
  }

  [data-sv] .sv-hero-video__layout {
    position: relative;
    width: 100%;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--c);
  }

  /* The layout owns the section's height directly — stretching against a
     min-height flex parent resolves inconsistently, so the same three
     heights are stated here and the children anchor to real edges. */
  .sv-hero-video--full .sv-hero-video__layout { min-height: calc(100svh - var(--sv-chrome-h, 0px) - var(--sv-bbar, 0px)); }
  .sv-hero-video--tall .sv-hero-video__layout { min-height: calc(82svh - var(--sv-chrome-h, 0px) - var(--sv-bbar, 0px)); }
  .sv-hero-video--standard .sv-hero-video__layout { min-height: calc(64svh - var(--sv-chrome-h, 0px) - var(--sv-bbar, 0px)); }

  [data-sv] .sv-hero-video__content {
    padding-block-end: var(--b);
    color: var(--cream);
    flex: 1 1 auto;
    min-width: 0;
    align-self: flex-end;
    text-shadow: 0 1px 22px rgba(26, 26, 26, 0.45);
  }

  /* The card rail — the reference layout's right-hand stack. Glass over the
     film: translucent ink with a blur, an ivory hairline, gold on hover.
     It sits mid-height like the reference, not baseline with the copy. */
  [data-sv] .sv-hero-video__cards {
    flex: 0 0 clamp(320px, 27vw, 500px);
    align-self: center;
    padding-block: var(--b);
  }

  .sv-hero-video__cards-track {
    display: flex;
    flex-direction: column;
    gap: var(--b);
  }

  /* The reference's movement is a STEP, not a drift: every few seconds the
     stack glides up by exactly one card — the top card exits through the
     container's clean clipped edge while a stand-in of the next-in-line
     rises from below, so every visible card stays fully solid; no fades,
     no half cards. The JS sizes the container to the resting stack and
     runs the glide (clone + transform + reorder). Hover or focus holds it. */
  [data-sv] .sv-hero-video__cards.is-marquee {
    overflow: hidden;
    padding-block: 0;
  }
  .is-marquee .sv-hero-video__cards-track { will-change: transform; }

  [data-sv] .sv-hero-video__card {
    display: flex;
    align-items: flex-start;
    gap: var(--a);
    padding: var(--b);
    border-radius: 22px;
    /* The reference floats its glass over a dark film; this film is bright
       ivory, so the tint carries more weight than theirs — but held light
       enough that the film clearly moves behind the glass. */
    background: rgba(26, 26, 26, 0.42);
    -webkit-backdrop-filter: blur(18px);
    backdrop-filter: blur(18px);
    border: 1px solid rgba(251, 247, 239, 0.16);
    box-shadow: 0 4px 24px rgba(26, 26, 26, 0.2);
    color: var(--cream);
    text-decoration: none;
    text-shadow: 0 1px 10px rgba(26, 26, 26, 0.4);
    transition: background 0.4s ease, transform 0.4s ease, border-color 0.4s ease, box-shadow 0.4s ease;
  }
  [data-sv] .sv-hero-video__card:hover {
    background: rgba(26, 26, 26, 0.56);
    border-color: rgba(251, 247, 239, 0.34);
    transform: translateY(-6px);
    box-shadow: 0 8px 32px rgba(26, 26, 26, 0.4);
  }

  .sv-hero-video__card-media {
    flex: 0 0 112px;
    height: 112px;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid rgba(251, 247, 239, 0.14);
    background: rgba(251, 247, 239, 0.12);
  }
  .sv-hero-video__card-media img,
  .sv-hero-video__card-ph {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .sv-hero-video__card-copy { min-width: 0; flex: 1 1 auto; }

  /* The gold hairline under each card's copy — the reference's signature. */
  .sv-hero-video__card-copy::after {
    content: '';
    display: block;
    height: 1px;
    margin-top: var(--b);
    background: linear-gradient(90deg, rgba(200, 168, 105, 0.65), rgba(200, 168, 105, 0));
  }

  [data-sv] .sv-hero-video__card-title {
    display: block;
    font-family: var(--serif);
    font-size: 1.35rem;
    line-height: 1.2;
  }
  [data-sv] .sv-hero-video__card-text {
    display: block;
    font-family: var(--sans);
    font-weight: 300;
    font-size: 0.85rem;
    line-height: 1.5;
    opacity: 0.88;
    margin-top: 6px;
  }

  .sv-hero-video__card-ph { opacity: 0.5; }

  [data-sv] .sv-hero-video__eyebrow {
    color: var(--cream);
    opacity: 0.85;
    margin-block-end: var(--a);
  }

  [data-sv] .sv-hero-video__heading {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: var(--cream);
    max-width: 14ch;
    margin: 0;
  }

  [data-sv] .sv-hero-video__body {
    max-width: 44ch;
    margin-block-start: var(--a);
    color: var(--cream);
    opacity: 0.9;
  }

  .sv-hero-video__lockup-row { margin-block-end: var(--a); }
  .sv-hero-video__lockup {
    width: min(440px, 72vw);
    max-width: none;
    height: auto;
    display: block;
    filter: drop-shadow(0 2px 18px rgba(26, 26, 26, 0.5));
  }

  /* The mark and the divider flower keep their colour; the wordmark and
     rule read in ivory. CSS wins over the SVG's fill attributes, so the
     snippet stays untouched. */
  .sv-hero-video__lockup text { fill: var(--cream); }
  .sv-hero-video__lockup > g:nth-of-type(2) { stroke: var(--cream); }

  .sv-hero-video__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--a);
    margin-block-start: var(--b);
  }

  /* The reference composition runs on pills; the square .btn geometry is
     rounded off here, hero-only, without touching the system primitive.
     Every hover changes the letter colour with the ground, never one alone. */
  [data-sv] .sv-hero-video__actions .btn {
    border-radius: 999px;
    padding: 18px 44px;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    text-transform: none;
    transition: background 0.3s ease, color 0.3s ease, border-color 0.3s ease;
  }
  [data-sv] .sv-hero-video__actions .btn--ivory:hover {
    background: var(--emerald);
    color: var(--cream);
  }

  [data-sv] .sv-hero-video__ghost {
    background: transparent;
    color: var(--cream);
    border-color: currentColor;
  }
  [data-sv] .sv-hero-video__ghost:hover {
    background: var(--cream);
    color: var(--emerald);
  }

  [data-sv] .sv-hero-video__glassbtn {
    background: rgba(26, 26, 26, 0.32);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border: 1px solid rgba(251, 247, 239, 0.28);
    color: var(--cream);
  }
  [data-sv] .sv-hero-video__glassbtn:hover {
    background: var(--cream);
    color: var(--ink);
    border-color: var(--cream);
  }

  /* Entrance — sv-motion.js reveals .rv once; the hero staggers its own. */
  .sv-hero-video__content .rv:nth-child(2) { transition-delay: 0.08s; }
  .sv-hero-video__content .rv:nth-child(3) { transition-delay: 0.16s; }
  .sv-hero-video__content .rv:nth-child(4) { transition-delay: 0.24s; }
  .sv-hero-video__cards-track > .rv:nth-child(1) { transition-delay: 0.2s; }
  .sv-hero-video__cards-track > .rv:nth-child(2) { transition-delay: 0.35s; }
  .sv-hero-video__cards-track > .rv:nth-child(3) { transition-delay: 0.5s; }
  .sv-hero-video__cards-track > .rv:nth-child(4) { transition-delay: 0.65s; }

  .sv-hero-video__toggle {
    position: absolute;
    right: var(--b);
    bottom: var(--b);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgba(251, 247, 239, 0.55);
    background: rgba(26, 26, 26, 0.28);
    color: var(--cream);
    display: grid;
    place-items: center;
    cursor: pointer;
  }
  .sv-hero-video__toggle:hover { background: rgba(26, 26, 26, 0.5); }

  /* The rail's own pause sits beside the film's — two circles, one habit.
     Phones scroll the rail natively and reduced motion never starts it,
     so the control exists only where the motion does. */
  .sv-hero-video__toggle--rail {
    right: calc(var(--b) + 44px + 10px);
  }
  @media (max-width: 900px) {
    .sv-hero-video__toggle--rail { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .sv-hero-video__toggle--rail { display: none; }
  }
  .sv-hero-video__glyph { width: 22px; height: 22px; }
  .sv-hero-video__glyph--play { display: none; }
  .sv-hero-video__toggle[aria-pressed='true'] .sv-hero-video__glyph--pause { display: none; }
  .sv-hero-video__toggle[aria-pressed='true'] .sv-hero-video__glyph--play { display: block; }

  @media (max-width: 900px) {
    [data-sv] .sv-hero-video__layout {
      flex-direction: column;
      align-items: stretch;
      justify-content: flex-end;
      gap: 0;
    }
    [data-sv] .sv-hero-video__content {
      padding-block-end: var(--b);
      align-self: stretch;
      /* In the column layout grow would pin the lockup to the top of the
         screen; everything belongs at the bottom, above the card strip. */
      flex: 0 0 auto;
    }

    /* A phone is not a small desktop: the lockup drops a size, the three
       actions shrink to compact pills flowing inline, and the rhythm
       tightens so the composition breathes instead of stacking. */
    .sv-hero-video__lockup { width: min(250px, 62vw); }
    .sv-hero-video__lockup-row { margin-block-end: 4px; }
    [data-sv] .sv-hero-video__actions {
      margin-block-start: var(--a);
      gap: 10px;
    }
    [data-sv] .sv-hero-video__actions .btn {
      padding: 13px 24px;
      font-size: 0.85rem;
    }
    [data-sv] .sv-hero-video__cards {
      flex-basis: auto;
      align-self: stretch;
      padding-block: 0 var(--b);
    }
    [data-sv] .sv-hero-video__cards:not(.is-marquee) {
      overflow-x: auto;
      scrollbar-width: none;
    }
    [data-sv] .sv-hero-video__cards:not(.is-marquee)::-webkit-scrollbar { display: none; }
    .sv-hero-video__cards-track { flex-direction: row; gap: var(--a); }
    [data-sv] .sv-hero-video__card {
      flex: 0 0 min(68vw, 260px);
      padding: var(--a);
      border-radius: 16px;
      align-items: center;
    }
    .sv-hero-video__card-media {
      flex-basis: 68px;
      height: 68px;
      border-radius: 10px;
    }
    [data-sv] .sv-hero-video__card-title { font-size: 1.05rem; }
    [data-sv] .sv-hero-video__card-text { font-size: 0.76rem; margin-top: 3px; }
    .sv-hero-video__card-copy::after { margin-top: var(--a); }

    /* Phase 1.7 — on phones the rail never auto-steps: the marquee form
       collapses into the same static horizontal scroll as the plain rail,
       and the JS declines to step at this width. */
    [data-sv] .sv-hero-video__cards.is-marquee {
      height: auto !important;
      overflow-x: auto;
      scrollbar-width: none;
      padding-block: 0 var(--b);
    }
    [data-sv] .sv-hero-video__cards.is-marquee::-webkit-scrollbar { display: none; }
    .is-marquee .sv-hero-video__cards-track { width: max-content; }
  }

  @media (max-width: 760px) {
    .sv-hero-video__toggle {
      right: var(--a);
      bottom: auto;
      /* Clear of the pill row that owns the top edge. The 56px that led
         this sum was the announcement strip at up to two lines on a narrow
         phone, and came off with it. */
      top: calc(var(--a) + 54px + var(--a));
    }
  }
{% endstylesheet %}

{% javascript %}
  document.querySelectorAll('[data-sv].sv-hero-video').forEach(function (section) {
    var video = section.querySelector('.sv-hero-video__media');
    var toggle = section.querySelector('[data-hero-toggle]');
    if (!video || !toggle) return;

    var userPaused = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function reflect() {
      toggle.setAttribute('aria-pressed', String(userPaused));
      toggle.setAttribute('aria-label', userPaused ? 'Play the film' : 'Pause the film');
    }

    toggle.addEventListener('click', function () {
      userPaused = !userPaused;
      if (userPaused) {
        video.dataset.userPaused = '1';
        video.pause();
      } else {
        delete video.dataset.userPaused;
        video.play().catch(function () {});
      }
      reflect();
    });

    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (userPaused) return;
            if (entry.isIntersecting) video.play().catch(function () {});
            else video.pause();
          });
        },
        { threshold: 0.1 }
      ).observe(section);
    }

    reflect();

    var cards = section.querySelector('.sv-hero-video__cards.is-marquee');
    if (cards && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      var track = cards.querySelector('.sv-hero-video__cards-track');
      var hovered = false;
      var stepping = false;
      cards.addEventListener('mouseenter', function () { hovered = true; });
      cards.addEventListener('mouseleave', function () { hovered = false; });

      /* Phones scroll the rail natively — no auto-step below 900px. */
      var isHorizontal = function () {
        return window.matchMedia('(max-width: 900px)').matches;
      };

      /* WCAG 2.2.2 — the rail's own pause, independent of the film's. */
      var railPaused = false;
      var railToggle = section.querySelector('[data-rail-toggle]');
      if (railToggle) {
        railToggle.addEventListener('click', function () {
          railPaused = !railPaused;
          railToggle.setAttribute('aria-pressed', String(railPaused));
          railToggle.setAttribute('aria-label', railPaused ? 'Play the card rail' : 'Pause the card rail');
        });
      }

      /* The container is sized to the resting stack so every visible card
         is whole — the total is invariant under rotation, so this only
         needs recomputing on resize. Mobile flows horizontally instead. */
      var fit = function () {
        if (stepping) return;
        cards.style.height = isHorizontal() ? '' : track.offsetHeight + 'px';
      };
      fit();
      window.addEventListener('resize', fit);

      var step = function () {
        if (stepping || hovered || railPaused || document.hidden) return;
        if (isHorizontal()) return;
        if (cards.matches(':focus-within')) return;
        var first = track.firstElementChild;
        if (!first || track.children.length < 2) return;
        stepping = true;

        var gap = parseFloat(getComputedStyle(track).gap) || 16;
        var dist = first.offsetHeight + gap;

        /* A stand-in of the departing card waits below the clipped edge and
           rides in as the stack glides — no gap ever opens. */
        var ghost = first.cloneNode(true);
        ghost.setAttribute('aria-hidden', 'true');
        ghost.setAttribute('tabindex', '-1');
        /* Not inert: inert swallows clicks, and a card mid-glide must still
           take a tap (same fix as sv-new-in's rail, Sep 2026). */
        track.appendChild(ghost);

        track.style.transition = 'transform 0.7s cubic-bezier(0.33, 0, 0.2, 1)';
        track.style.transform = 'translateY(-' + dist + 'px)';

        var settled = false;
        var settle = function () {
          if (settled) return;
          settled = true;
          track.removeEventListener('transitionend', settle);
          track.style.transition = 'none';
          track.appendChild(first);
          ghost.remove();
          track.style.transform = '';
          void track.offsetHeight;
          track.style.transition = '';
          stepping = false;
        };
        track.addEventListener('transitionend', settle);
        setTimeout(settle, 900);
      };

      setInterval(step, 3200);
    }

    /* Dropdown state (Phase 1.2). CSS opens the panels on hover and
       :focus-within; here the button's aria-expanded mirrors that, and
       Escape closes — .is-closed suppresses the CSS while the refocused
       button would otherwise hold the panel open through :focus-within. */
    section.querySelectorAll('[data-navitem]').forEach(function (item) {
      var btn = item.querySelector('button[aria-expanded]');
      if (!btn) return;
      var sync = function (open) { btn.setAttribute('aria-expanded', String(open)); };

      item.addEventListener('mouseenter', function () { item.classList.remove('is-closed'); sync(true); });
      item.addEventListener('mouseleave', function () {
        item.classList.remove('is-closed');
        sync(item.matches(':focus-within'));
      });
      item.addEventListener('focusin', function () {
        if (!item.classList.contains('is-closed')) sync(true);
      });
      item.addEventListener('focusout', function (e) {
        if (!item.contains(e.relatedTarget)) { item.classList.remove('is-closed'); sync(false); }
      });
      item.addEventListener('keydown', function (e) {
        if (e.key !== 'Escape') return;
        item.classList.add('is-closed');
        sync(false);
        btn.focus();
      });
      btn.addEventListener('click', function () {
        var closed = item.classList.toggle('is-closed');
        sync(!closed);
      });
    });

    /* Nav hand-off for the §08b curtain. The glass chrome is pinned
       with the film, so the arriving page covers it; body.sv-curtained
       brings the standing sv-header in at exactly that moment (see the
       stylesheet above). "That moment" is read geometrically: a covering
       surface — any section after the hero, or the footer — touching a
       zero-height line at the top of the viewport (rootMargin collapses
       the root to its top edge). IntersectionObserver only, per the
       performance rule; with script off the class never appears and the
       page keeps today's behaviour. */
    if ('IntersectionObserver' in window && section.hasAttribute('data-float-nav')) {
      var heroWrap = section.closest('.shopify-section');
      var surfaces = [];
      var sib = heroWrap && heroWrap.nextElementSibling;
      while (sib) {
        if (sib.classList && sib.classList.contains('shopify-section')) surfaces.push(sib);
        sib = sib.nextElementSibling;
      }
      var pageFooter = document.querySelector('.page-wrapper > footer');
      if (pageFooter) surfaces.push(pageFooter);

      if (surfaces.length) {
        var atTop = new Set();
        var coverWatch = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) atTop.add(entry.target);
            else atTop.delete(entry.target);
          });
          document.body.classList.toggle('sv-curtained', atTop.size > 0);
        }, { rootMargin: '0px 0px -100% 0px', threshold: 0 });
        surfaces.forEach(function (el) { coverWatch.observe(el); });
      }
    }
  });
{% endjavascript %}


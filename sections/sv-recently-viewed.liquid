{%- comment -%}
  "Recently viewed" (the lemoon carousel). Rendered in script from this
  device's own history — localStorage `sv_recent`, written by
  sv-product.js — so the server sends only an empty, hidden shell. The
  product being viewed is left out. First visit: nothing to show, and
  nothing shows.
{%- endcomment -%}

<section
  class="sv-shelf"
  data-sv
  data-sv-recent
  data-sv-shelf
  data-current="{{ product.handle }}"
  data-max="{{ section.settings.limit }}"
  hidden
>
  <div class="w">
    <div class="sv-shelf__head">
      <h2 class="sv-shelf__h">{{ section.settings.heading }}</h2>
      <div class="sv-shelf__nav">
        <button type="button" class="sv-shelf__btn" data-sv-shelf-step="-1" aria-label="Scroll back">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" d="m14.5 6-6 6 6 6"/></svg>
        </button>
        <button type="button" class="sv-shelf__btn" data-sv-shelf-step="1" aria-label="Scroll forward">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" d="m9.5 6 6 6-6 6"/></svg>
        </button>
      </div>
    </div>
    <ul class="sv-shelf__row" role="list" data-sv-shelf-row></ul>
  </div>
</section>

<script src="{{ 'sv-shelf.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "SV Recently viewed",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Recently viewed" },
    { "type": "range", "id": "limit", "label": "Products", "min": 4, "max": 12, "step": 1, "default": 8 }
  ],
  "presets": [{ "name": "SV Recently viewed" }]
}
{% endschema %}

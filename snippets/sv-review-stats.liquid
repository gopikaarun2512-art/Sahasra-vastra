{% doc %}
  A product's published reviews, counted. Prints "count,sum,n5,n4,n3,n2,n1"
  and nothing else, for capture — used by the reviews section and by the
  star line beside the product title, so the two can never disagree.

  Reviews are `sv_review` metaobject (shown in Admin as "Product review") entries (Admin → Content →
  Metaobjects → Product review), one per review, each pointing at its
  product. Only entries set to Active are visible to the storefront, so
  "Draft" is how a review waits for approval. Ratings are rounded to the
  nearest star for the distribution; the average uses the exact values.

  @param {object} product
{% enddoc %}

{%- liquid
  assign count = 0
  assign sum = 0
  assign n5 = 0
  assign n4 = 0
  assign n3 = 0
  assign n2 = 0
  assign n1 = 0
  for r in shop.metaobjects.sv_review.values
    if r.product.value.id != product.id
      continue
    endif
    assign stars = r.rating.value.rating | plus: 0
    if stars <= 0
      continue
    endif
    assign count = count | plus: 1
    assign sum = sum | plus: stars
    assign whole = stars | round
    case whole
      when 5
        assign n5 = n5 | plus: 1
      when 4
        assign n4 = n4 | plus: 1
      when 3
        assign n3 = n3 | plus: 1
      when 2
        assign n2 = n2 | plus: 1
      else
        assign n1 = n1 | plus: 1
    endcase
  endfor
  echo count | append: ',' | append: sum | append: ',' | append: n5 | append: ',' | append: n4 | append: ',' | append: n3 | append: ',' | append: n2 | append: ',' | append: n1
-%}

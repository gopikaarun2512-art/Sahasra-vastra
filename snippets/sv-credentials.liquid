{% doc %}
  The statutory line. GSTIN · Udyam · Grievance Officer · support email.

  Every value reads from a shop metafield. There is no `default:` filter here
  and there must never be one: a default is a hard-coded business value in
  disguise, and it keeps rendering the stale figure after Admin is corrected.

  An absent field contributes nothing — no label, no dash, no placeholder
  (ARCHITECTURE.md rule 11). If every field is empty the snippet renders
  nothing at all, not an empty paragraph.

  Wording: CONTENT.md §03, footer statutory line.

  @example
  {% render 'sv-credentials' %}
{% enddoc %}

{%- liquid
  assign gstin = shop.metafields.custom.gstin.value
  assign udyam = shop.metafields.custom.udyam.value
  assign officer = shop.metafields.custom.grievance_officer.value
  assign email = shop.metafields.custom.support_email.value
-%}

{%- capture raw_parts -%}
  {%- if gstin != blank -%}GSTIN {{ gstin }}~{%- endif -%}
  {%- if udyam != blank -%}Udyam registered~{%- endif -%}
  {%- if officer != blank -%}Grievance Officer: {{ officer }}~{%- endif -%}
  {%- if email != blank -%}<a class="sv-credentials__link" href="mailto:{{ email }}">{{ email }}</a>~{%- endif -%}
{%- endcapture -%}

{%- assign parts = raw_parts | strip | split: '~' -%}

{%- if parts.size > 0 -%}
  <p class="sv-fine sv-credentials">
    {%- for part in parts -%}
      {%- unless forloop.first %} · {% endunless -%}
      {{- part | strip -}}
    {%- endfor -%}
  </p>
{%- endif -%}

{% stylesheet %}
  /* Type comes from .sv-fine (sv-system.css v1.2) — the small-print scale this
     line previously had to inherit. Only colour and measure are set here, and
     the muted tone is an opacity on a token, never a literal. */
  /* Compound selector so the 78ch measure beats [data-sv] p's 56ch (0,1,1),
     which a bare class (0,1,0) would lose to — the statutory line is one long
     run and wraps badly at body measure. */
  [data-sv] .sv-credentials {
    color: var(--cream);
    opacity: 0.74;
    max-width: 78ch;
  }

  .sv-credentials__link {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .sv-credentials__link:hover {
    opacity: 1;
  }
{% endstylesheet %}

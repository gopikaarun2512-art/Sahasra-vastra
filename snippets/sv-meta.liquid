{% doc %}
  Sahasra Vastra — the single source of head metadata.

  Spec: ARCHITECTURE.md §10.1. Replaces Horizon's snippets/meta-tags.liquid,
  which is no longer rendered by either layout. Nothing emitted here may also
  be emitted elsewhere in <head>: duplicate og tags are worse than none,
  because crawlers choose between them unpredictably.

  Structured data emitted here: Organization + WebSite on index,
  BreadcrumbList on collection and product.
  Product JSON-LD is NOT emitted here — Horizon already emits it from
  sections/product-information.liquid via the structured_data filter.
{% enddoc %}

<meta charset="utf-8">
<meta
  http-equiv="X-UA-Compatible"
  content="IE=edge"
>
<meta
  name="viewport"
  content="width=device-width,initial-scale=1"
>

{%- comment -%}
  Brand icons. Deliberately not settings.favicon: the mark is design system,
  not business data, and it must not drift from the lockup beside it. The
  layouts no longer emit an icon link, so these are the only ones.
{%- endcomment -%}
<link
  rel="icon"
  type="image/png"
  sizes="512x512"
  href="{{ 'favicon-512.png' | asset_url }}"
>
<link
  rel="apple-touch-icon"
  sizes="180x180"
  href="{{ 'favicon-180-apple-touch.png' | asset_url }}"
>

{%- liquid
  assign og_title = page_title | default: shop.name

  # A shared link is often the first thing anyone sees of the shop, so the
  # card never falls back to the bare shop name twice over. shop.description
  # is empty in Admin and the password page has no page_description at all,
  # which left WhatsApp printing "Sahasra Vastra / Sahasra Vastra".
  assign house_line = 'Baby and kidswear for 0–8 years — sleepsuits, co-ord sets and everyday cottons, chosen by age.'
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: house_line

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
    assign og_title = shop.name
    assign og_description = house_line
  endif

  # og:image fallback chain — ASSETS.md §10.
  # page_image resolves to the first gallery image on a product, the article
  # image on an article, and the page or collection image where one is set.
  # Everything else falls back to the single site-wide default.
  # Always requested at 1200x630 exactly, per ASSETS.md §4.
  if page_image
    assign og_image_src = page_image | image_url: width: 1200, height: 630, crop: 'center'
  else
    assign og_image_src = 'sv-og-default.jpg' | asset_url
  endif

  # asset_url and image_url both return a protocol-relative //cdn.shopify.com
  # URL. Normalise to absolute https so the tag is resolvable standalone.
  assign og_image_url = og_image_src | split: '//' | last | prepend: 'https://'
-%}

{%- comment -%}
  A tag-filtered collection is a size, not a database row: the stock
  title read `tagged "age-6-9m"` in the browser tab, in a shared link
  and in a search result. Age tags print the way the chips print them.
{%- endcomment -%}
{%- liquid
  assign tag_label = ''
  for tag in current_tags
    assign one = tag
    if tag contains 'age-'
      assign bits = tag | remove_first: 'age-' | split: '-'
      assign unit = 'm'
      if tag contains 'y'
        assign unit = 'y'
      endif
      assign to = bits.last | remove: 'm' | remove: 'y'
      assign one = bits.first | append: '–' | append: to | append: ' ' | append: unit
    endif
    if tag_label == ''
      assign tag_label = one
    else
      assign tag_label = tag_label | append: ', ' | append: one
    endif
  endfor
-%}
{%- comment -%}
  page_title is empty on the password page, which printed a bare
  "&ndash; Sahasra Vastra" in the tab and in every shared link.
{%- endcomment -%}
{%- assign head_title = page_title | default: shop.name -%}
<title>
  {{ head_title }}
  {%- if tag_label != '' %} &ndash; {{ tag_label }}{% endif -%}
  {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
  {%- unless head_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
</title>

<link
  rel="canonical"
  href="{{ canonical_url }}"
>

{%- if page_description -%}
  <meta
    name="description"
    content="{{ page_description | escape }}"
  >
{%- endif -%}

<meta
  property="og:site_name"
  content="{{ shop.name }}"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>
<meta
  property="og:locale"
  content="en_IN"
>
<meta
  property="og:image"
  content="{{ og_image_url }}"
>
<meta
  property="og:image:secure_url"
  content="{{ og_image_url }}"
>
<meta
  property="og:image:width"
  content="1200"
>
<meta
  property="og:image:height"
  content="630"
>

{%- if request.page_type == 'product' -%}
  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta
    name="twitter:site"
    content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}"
  >
{%- endif -%}
<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>
<meta
  name="twitter:image"
  content="{{ og_image_url }}"
>

{%- liquid
  assign site_url = request.origin | append: routes.root_url
-%}

{%- if request.page_type == 'index' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": {{ shop.name | json }},
      "url": {{ site_url | json }}
      {%- if settings.logo -%}
        , "logo": {{ settings.logo | image_url: width: 500 | split: '//' | last | prepend: 'https://' | json }}
      {%- endif -%}
    }
  </script>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "url": {{ site_url | json }}
    }
  </script>
{%- endif -%}

{%- if request.page_type == 'collection' and collection.title != blank -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": {{ shop.name | json }},
          "item": {{ site_url | json }}
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": {{ collection.title | json }},
          "item": {{ request.origin | append: collection.url | json }}
        }
      ]
    }
  </script>
{%- endif -%}

{%- if request.page_type == 'product' and product.title != blank -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": {{ shop.name | json }},
          "item": {{ site_url | json }}
        }
        {%- if collection.title != blank -%}
          ,
          {
            "@type": "ListItem",
            "position": 2,
            "name": {{ collection.title | json }},
            "item": {{ request.origin | append: collection.url | json }}
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": {{ product.title | json }},
            "item": {{ request.origin | append: product.url | json }}
          }
        {%- else -%}
          ,
          {
            "@type": "ListItem",
            "position": 2,
            "name": {{ product.title | json }},
            "item": {{ request.origin | append: product.url | json }}
          }
        {%- endif -%}
      ]
    }
  </script>
{%- endif -%}

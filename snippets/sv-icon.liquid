{% doc %}
  Inline SVG icon lookup. Never an icon font — ARCHITECTURE.md §1, rule 9.

  Every icon is decorative: it inherits `currentColor` and carries
  aria-hidden. The accessible name belongs on the control that wraps it,
  as an aria-label, never on the glyph.

  @param {string} name - whatsapp | cart | search | menu | close | external | instagram | facebook | home | orders | account | hanger | share | heart | pinterest | mail | link | truck | clock | shield
  @param {string} [class] - class applied to the <svg>

  @example
  <a href="/cart" aria-label="Cart">{% render 'sv-icon', name: 'cart' %}</a>
{% enddoc %}

{%- capture svg_open -%}
  <svg {% if class %}class="{{ class }}"{% endif %} viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
{%- endcapture -%}


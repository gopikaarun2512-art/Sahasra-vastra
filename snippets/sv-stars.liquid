{%- comment -%}
  Five stars filled to a rating, e.g. 4.3 → four full, one 30% — one
  clipped gold row over a grey one, so any fraction draws exactly.
  @param {number} rating  @param {string} [class]
{%- endcomment -%}
{%- assign pct = rating | times: 20.0 | at_most: 100 | at_least: 0 -%}
<span class="sv-stars {{ class }}" style="--sv-stars: {{ pct }}%" role="img" aria-label="{{ rating | round: 1 }} out of 5 stars">
  <span class="sv-stars__row" aria-hidden="true">★★★★★</span>
  <span class="sv-stars__row sv-stars__row--on" aria-hidden="true">★★★★★</span>
</span>
